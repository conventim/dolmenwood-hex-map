---
import Base from "../../layouts/BaseMinimal.astro";
import { modules } from "../../data/dolmenwood-map-modules";
import { pois } from "../../data/map-pois";
import { updates } from "../../data/map-updates";
import { marked } from "marked";
import hexColors from "../../data/hex-colors.json";
import hexPages from "../../data/hex-pages.json";
import { addAbbrTags, linkifyHexRefs } from "../../lib/map/text-transforms";
import { CANONICAL_URL, contactEmailWithTag } from "../../lib/config";

interface ModuleLink {
  label: string;
  url: string;
}

interface ModuleInfo {
  name: string;
  levels: string;
  official: boolean;
  ose: boolean;
  descriptionHtml: string;
  estimated: boolean;
  links: ModuleLink[];
}

// Build hex-indexed lookup: Record<string, ModuleInfo[]>
const hexModules: Record<string, ModuleInfo[]> = {};
for (const mod of modules) {
  if (!("hexes" in mod)) continue;
  const descHtml = addAbbrTags(await marked(mod.description));
  for (const hex of mod.hexes) {
    const estimated = !new RegExp(`\\b${hex}\\b`).test(mod.location);
    const info: ModuleInfo = {
      name: mod.name,
      levels: mod.levels,
      official: mod.official,
      ose: mod.ose,
      descriptionHtml: descHtml,
      estimated,
      links: mod.links,
    };
    if (!hexModules[hex]) hexModules[hex] = [];
    hexModules[hex].push(info);
  }
}

interface PoiInfo {
  name: string;
  category: string;
}

const hexPois: Record<string, PoiInfo[]> = {};
for (const poi of pois) {
  const info: PoiInfo = {
    name: poi.name,
    category: poi.category,
  };
  if (!hexPois[poi.hex]) hexPois[poi.hex] = [];
  hexPois[poi.hex].push(info);
}

const modulesJson = JSON.stringify(hexModules);
const poisJson = JSON.stringify(hexPois);
const hexColorsJson = JSON.stringify(hexColors);
const hexPagesJson = JSON.stringify(hexPages);
const updatesJson = JSON.stringify(updates);

// Build array of modules without hex associations (for search)
const locationModules = await Promise.all(
  modules
    .filter((mod) => !("hexes" in mod))
    .map(async (mod) => ({
      name: mod.name,
      location: mod.location,
      descriptionHtml: addAbbrTags(await marked(mod.description)),
    })),
);
const locationModulesJson = JSON.stringify(locationModules);

// Build sorted adventure list for below-map display
interface AdventureEntry {
  name: string;
  levels: string;
  location: string;
  locationHtml: string;
  official: boolean;
  ose: boolean;
  hexes: string[];
  descriptionHtml: string;
  links: ModuleLink[];
}

const adventureList: AdventureEntry[] = await Promise.all(
  modules.map(async (mod) => ({
    name: mod.name,
    levels: mod.levels,
    location: mod.location,
    locationHtml: linkifyHexRefs(mod.location),
    official: mod.official,
    ose: mod.ose,
    hexes: "hexes" in mod ? [...mod.hexes] : [],
    descriptionHtml: linkifyHexRefs(addAbbrTags(await marked(mod.description))),
    links: mod.links,
  })),
);

adventureList.sort((a, b) =>
  a.name.toLowerCase().localeCompare(b.name.toLowerCase()),
);

const contactMailto = contactEmailWithTag("dolmenwood-map");
---

<Base
  title="Dolmenwood Hex Map"
  description="Interactive hex map of Dolmenwood with module hex annotations - Find your next adventure."
  ogImage={`${import.meta.env.BASE_URL}map/images/map-og.jpg`}
  canonicalUrl={CANONICAL_URL || undefined}
>
  <style is:inline>
    /* Theme custom properties — organic earth-tone palette */
    :root {
      --map-body-bg: #d3d3d3;
      --sidebar-bg: #faf7f0;
      --sidebar-text: #4a3c2a;
      --sidebar-heading: #2c1e0e;
      --sidebar-border: #d6c9ad;
      --sidebar-link: #7a5232;
      --sidebar-levels: #5c4e3a;
      --sidebar-desc: #5c4e3a;
      --sidebar-close: #a89880;
      --sidebar-close-hover: #3b2c1a;
      --sidebar-shadow: rgb(60 40 20 / 12%);
      --tooltip-bg: #fffdf7;
      --tooltip-text: #4a3c2a;
      --tooltip-name: #2c1e0e;
      --tooltip-level: #5c4e3a;
      --tooltip-shadow: rgb(60 40 20 / 12%);
      --toggle-bg: #ddd1b8;
      --toggle-text: #4a3c2a;
      --toggle-hover: #cec0a4;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      /* stylelint-disable-next-line property-no-deprecated -- fallback for older browsers */
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    html {
      height: 100%;
    }

    body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      background: var(--map-body-bg) !important;
      color: unset;
    }

    main {
      width: 100%;
      height: 100%;
    }

    #map-container {
      width: 100%;
      height: 100%;
      overflow: auto;
      box-sizing: border-box;
      transition: width 0.3s ease;
    }

    body.sidebar-open #map-container {
      width: calc(100% - 400px);
    }

    #map {
      display: block;
      margin-top: 50px;
    }

    /* Tooltip */
    #tooltip {
      display: none;
      position: fixed;
      background: var(--tooltip-bg);
      color: var(--tooltip-text);
      padding: 8px 14px;
      border-radius: 6px;
      font:
        14px/1.4 system-ui,
        sans-serif;
      pointer-events: none;
      z-index: 1000;
      max-width: 300px;
      box-shadow: 0 2px 8px var(--tooltip-shadow);
    }

    #tooltip .tt-name {
      font-weight: 600;
      color: var(--tooltip-name);
    }

    #tooltip .tt-hex {
      color: #000;
      font-weight: 700;
      margin-bottom: 4px;
    }

    #tooltip .tt-level {
      color: var(--tooltip-level);
      font-size: 12px;
      margin-left: 6px;
    }

    /* Sidebar */
    #sidebar {
      position: fixed;
      top: 0;
      right: 0;
      width: 400px;
      height: 100%;
      background: var(--sidebar-bg);
      color: var(--sidebar-text);
      transform: translateX(100%);
      transition: transform 0.3s ease;
      z-index: 900;
      overflow-y: auto;
      font:
        15px/1.6 system-ui,
        sans-serif;
      box-shadow: -2px 0 12px var(--sidebar-shadow);
    }

    #sidebar.open {
      transform: translateX(0);
    }

    #sidebar:focus {
      outline: none;
    }

    #sidebar-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--sidebar-border);
      position: sticky;
      top: 0;
      background: var(--sidebar-bg);
    }

    #sidebar-header .header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    #sidebar-header h2 {
      font-size: 20px;
      color: var(--sidebar-heading);
      margin: 0;
      display: flex;
      gap: 16px;
      align-items: baseline;
    }

    #sidebar-close {
      background: none;
      border: none;
      color: var(--sidebar-close);
      font-size: 28px;
      cursor: pointer;
      line-height: 1;
      padding: 0 4px;
    }

    #sidebar-close:hover {
      color: var(--sidebar-close-hover);
    }

    #sidebar-content {
      padding: 20px;
    }

    #sidebar-content .module {
      margin-bottom: 24px;
    }

    #sidebar-content .module h3 {
      margin: 0 0 8px;
    }

    #sidebar-content .module h3 a {
      color: var(--sidebar-link);
      text-decoration: none;
    }

    #sidebar-content .module h3 a:hover {
      text-decoration: underline;
    }

    #sidebar-content .module-levels {
      color: var(--sidebar-levels);
    }

    #sidebar-content .module-desc p {
      color: var(--sidebar-desc);
      margin: 0 0 12px;
    }

    #sidebar-content .module-desc p:last-child {
      margin-bottom: 0;
    }

    #sidebar-content .module-desc a {
      color: var(--sidebar-link);
    }

    #sidebar-content .module-meta {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 13px;
      margin-bottom: 8px;
    }

    #sidebar-content .module-links a {
      color: var(--sidebar-link);
    }

    /* DM Notes */
    .notes-section {
      border-bottom: 1px solid var(--sidebar-border);
      padding: 12px 16px;
    }

    .notes-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }

    .notes-header h3 {
      margin: 0;
      font-size: 14px;
      color: var(--sidebar-heading);
      font-weight: 600;
    }

    .notes-header button {
      background: none;
      border: none;
      color: var(--sidebar-levels);
      cursor: pointer;
      padding: 2px 6px;
      font-size: 14px;
      border-radius: 3px;
    }

    .notes-header button:hover {
      background: rgb(255 255 255 / 10%);
    }

    .notes-view {
      font-size: 14px;
      line-height: 1.5;
      color: var(--sidebar-desc);
      overflow-wrap: break-word;
    }

    .notes-title-view {
      color: var(--sidebar-heading);
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .notes-view h1,
    .notes-view h2,
    .notes-view h3,
    .notes-view h4 {
      color: var(--sidebar-heading);
      margin: 12px 0 4px;
      font-size: 14px;
    }

    .notes-view h1 {
      font-size: 16px;
    }

    .notes-view h2 {
      font-size: 15px;
    }

    .notes-view p {
      margin: 0 0 8px;
    }

    .notes-view ul,
    .notes-view ol {
      margin: 0 0 8px;
      padding-left: 20px;
    }

    .notes-view code {
      background: rgb(255 255 255 / 8%);
      padding: 1px 4px;
      border-radius: 3px;
      font-size: 13px;
    }

    .notes-view pre {
      background: rgb(255 255 255 / 6%);
      padding: 8px;
      border-radius: 4px;
      overflow-x: auto;
      margin: 0 0 8px;
    }

    .notes-view pre code {
      background: none;
      padding: 0;
    }

    .notes-view a {
      color: var(--sidebar-link);
    }

    .notes-view hr {
      border: none;
      border-top: 1px solid var(--sidebar-border);
      margin: 8px 0;
    }

    .notes-textarea {
      width: 100%;
      min-height: 120px;
      background: rgb(255 255 255 / 6%);
      color: var(--sidebar-heading);
      border: 1px solid var(--sidebar-border);
      border-radius: 4px;
      padding: 8px;
      font:
        13px/1.4 "SF Mono",
        "Fira Code",
        "Fira Mono",
        Menlo,
        monospace;
      resize: vertical;
      box-sizing: border-box;
    }

    .notes-textarea:focus {
      outline: none;
      border-color: #2d6a4f;
    }

    .notes-hint {
      font-size: 11px;
      color: var(--sidebar-levels);
      margin: 4px 0 0;
    }

    .notes-category-label {
      display: block;
      color: var(--sidebar-levels);
      font-size: 12px;
      margin-bottom: 4px;
    }

    .notes-title-label {
      display: block;
      color: var(--sidebar-levels);
      font-size: 12px;
      margin-bottom: 4px;
    }

    .notes-title {
      width: 100%;
      margin-bottom: 8px;
      padding: 6px 8px;
      border: 1px solid var(--sidebar-border);
      border-radius: 4px;
      background: var(--sidebar-bg);
      color: var(--sidebar-text);
      box-sizing: border-box;
      font-size: 13px;
    }

    .notes-category {
      width: 100%;
      margin-bottom: 8px;
      padding: 6px 8px;
      border: 1px solid var(--sidebar-border);
      border-radius: 4px;
      background: var(--sidebar-bg);
      color: var(--sidebar-text);
      font-size: 13px;
    }

    .notes-color-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: -2px 0 8px;
      color: var(--sidebar-levels);
      font-size: 12px;
    }

    .notes-color-swatch {
      width: 16px;
      height: 16px;
      border: 1px solid rgb(0 0 0 / 25%);
      border-radius: 3px;
      box-sizing: border-box;
    }

    .notes-actions {
      display: flex;
      gap: 8px;
      margin-top: 8px;
    }

    .notes-actions button {
      padding: 4px 12px;
      border-radius: 4px;
      font-size: 13px;
      cursor: pointer;
      border: 1px solid var(--sidebar-border);
      background: rgb(255 255 255 / 8%);
      color: var(--sidebar-heading);
    }

    .notes-actions button:first-child {
      background: #2d6a4f;
      border-color: #2d6a4f;
      color: #fff;
    }

    .notes-actions button:hover {
      opacity: 0.85;
    }

    .notes-add-btn {
      display: block;
      width: 100%;
      padding: 10px;
      background: none;
      border: 1px dashed var(--sidebar-border);
      border-radius: 4px;
      color: var(--sidebar-levels);
      font-size: 13px;
      cursor: pointer;
      text-align: center;
    }

    .notes-add-btn:hover {
      border-color: var(--sidebar-heading);
      color: var(--sidebar-heading);
    }

    abbr[data-tooltip] {
      text-decoration: underline dotted;
    }

    [data-tooltip] {
      cursor: help;
    }

    #attr-tooltip {
      display: none;
      position: fixed;
      padding: 4px 8px;
      background: var(--tooltip-bg);
      color: var(--tooltip-text);
      font:
        14px/1.4 system-ui,
        sans-serif;
      max-width: 300px;
      border: 1px solid var(--sidebar-border);
      border-radius: 4px;
      box-shadow: 0 2px 8px var(--tooltip-shadow);
      pointer-events: none;
      z-index: 1001;
    }

    /* DCB page reference (inline with title) */
    #sidebar-header .hex-page-ref {
      color: var(--sidebar-levels);
      font-size: 13px;
      font-weight: normal;
      margin-left: 8px;
    }

    /* POI sidebar entries */
    #sidebar-header .poi {
      display: flex;
      align-items: baseline;
      gap: 16px;
      margin-top: 8px;
    }

    #sidebar-header .poi h3 {
      margin: 0;
      font-size: 15px;
      font-weight: normal;
      color: var(--sidebar-heading);
    }

    #sidebar-header .poi-meta {
      color: var(--sidebar-levels);
      font-size: 13px;
    }

    /* Tooltip category label */
    #tooltip .tt-cat {
      color: var(--tooltip-level);
      font-size: 12px;
      margin-left: 6px;
    }

    /* Exploration state in tooltip */
    #tooltip .tt-state {
      color: var(--sidebar-levels);
      font-size: 12px;
      font-style: italic;
    }

    /* Exploration state in sidebar */
    #sidebar-exploration {
      margin-top: 6px;
    }

    #sidebar-exploration .exploration-badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 2px 8px;
      border-radius: 3px;
    }

    #sidebar-exploration .exploration-badge.partial {
      background: rgb(80 180 170 / 15%);
      color: rgb(80 180 170 / 100%);
    }

    #sidebar-exploration .exploration-badge.visited {
      background: rgb(160 160 160 / 15%);
      color: rgb(120 120 120 / 100%);
    }

    /* Top controls (hex search + modules link) */
    #top-controls {
      position: fixed;
      top: 12px;
      left: 12px;
      z-index: 950;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    #search-container {
      position: relative;
    }

    #hex-search {
      width: 240px;
      padding: 8px 12px;
      padding-left: 12px;
      padding-right: 34px;
      background: var(--toggle-bg);
      color: var(--toggle-text);
      border: none;
      border-radius: 20px;
      font:
        14px/1 system-ui,
        sans-serif;
      text-align: left;
      box-shadow: 0 2px 6px rgb(0 0 0 / 30%);
      outline: none;
      box-sizing: border-box;
    }

    #search-clear {
      position: absolute;
      top: 50%;
      right: 6px;
      width: 24px;
      height: 24px;
      padding: 0;
      transform: translateY(-50%);
      background: rgb(0 0 0 / 14%);
      color: var(--toggle-text);
      border: none;
      border-radius: 50%;
      font:
        16px/1 system-ui,
        sans-serif;
      cursor: pointer;
    }

    #search-clear:hover,
    #search-clear:focus-visible {
      background: rgb(0 0 0 / 24%);
    }

    #search-clear[hidden] {
      display: none;
    }

    #hex-search[aria-expanded="true"] {
      border-radius: 12px 12px 0 0;
    }

    #search-results {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      padding: 0;
      list-style: none;
      background: var(--sidebar-bg);
      color: var(--sidebar-text);
      max-height: 320px;
      overflow-y: auto;
      z-index: 960;
      border-radius: 0 0 12px 12px;
      box-shadow: 0 4px 12px rgb(0 0 0 / 25%);
    }

    #search-results[data-open="true"] {
      display: block;
    }

    #search-results li {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      padding: 8px 12px;
      cursor: pointer;
      font:
        13px/1.3 system-ui,
        sans-serif;
    }

    #search-results li:last-child {
      border-radius: 0 0 12px 12px;
    }

    #search-results li[aria-selected="true"] {
      background: var(--toggle-bg);
    }

    #search-results li:hover {
      background: var(--toggle-hover);
    }

    #search-results .sr-badge {
      flex-shrink: 0;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 2px 6px;
      border-radius: 3px;
      background: var(--sidebar-border);
      color: var(--sidebar-heading);
    }

    #search-results .sr-label {
      display: block;
      flex: 1;
      min-width: 0;
      overflow-wrap: anywhere;
    }

    #search-results .sr-main {
      flex: 1;
      min-width: 0;
    }

    #search-results .sr-match {
      display: block;
      margin-top: 2px;
      color: var(--sidebar-levels);
      font-size: 11px;
      line-height: 1.25;
      overflow-wrap: anywhere;
    }

    #search-results .sr-hex {
      flex-shrink: 0;
      font-size: 12px;
      color: var(--sidebar-levels);
      font-variant-numeric: tabular-nums;
    }

    #see-modules {
      font:
        13px/1 system-ui,
        sans-serif;
      color: var(--sidebar-levels);
      text-decoration: none;
      display: block;
      white-space: nowrap;
    }

    #see-modules:hover {
      text-decoration: underline;
    }

    /* Progress meter */
    #hex-progress {
      position: fixed;
      bottom: 12px;
      left: 12px;
      z-index: 950;
      font:
        12px/1 system-ui,
        sans-serif;
      color: var(--sidebar-levels);
      background: var(--toggle-bg);
      padding: 8px 12px;
      border-radius: 12px;
      box-shadow: 0 2px 6px rgb(0 0 0 / 30%);
    }

    #hex-search::placeholder {
      color: var(--sidebar-levels);
    }

    @media (width <= 500px) {
      #hex-search {
        width: 150px;
      }
    }

    /* Modal (shared) */
    .modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 2000;
      background: rgb(0 0 0 / 50%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-box {
      position: relative;
      background: var(--sidebar-bg);
      color: var(--sidebar-text);
      padding: 24px 32px;
      border-radius: 12px;
      box-shadow: 0 4px 24px rgb(0 0 0 / 40%);
      font:
        14px/1.6 system-ui,
        sans-serif;
    }

    .modal-close {
      position: absolute;
      top: 12px;
      right: 12px;
      background: none;
      border: none;
      color: var(--sidebar-close);
      font-size: 22px;
      cursor: pointer;
      line-height: 1;
      padding: 0 4px;
    }

    .modal-close:hover {
      color: var(--sidebar-close-hover);
    }

    #delete-note-box {
      min-width: 280px;
      text-align: center;
    }

    #delete-note-box h3 {
      margin: 0 0 8px;
      color: var(--sidebar-heading);
    }

    #delete-note-box p {
      margin: 0 0 20px;
    }

    .delete-note-actions {
      display: flex;
      justify-content: center;
      gap: 10px;
    }

    .delete-note-actions button {
      padding: 8px 18px;
      border: 1px solid var(--sidebar-border);
      border-radius: 6px;
      background: var(--sidebar-bg);
      color: var(--sidebar-text);
      cursor: pointer;
    }

    .delete-note-actions button:hover {
      background: var(--toggle-hover);
    }

    .delete-note-actions #delete-note-confirm {
      border-color: #a0522d;
      background: #a0522d;
      color: #fff;
    }

    /* Help modal */
    #help-box {
      min-width: 260px;
    }

    #help-box h3 {
      margin: 0 0 12px;
      color: var(--sidebar-heading);
      font-size: 16px;
    }

    #help-box dl {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 6px 16px;
      margin: 0;
    }

    #help-box dt {
      text-align: right;
    }

    #help-box dd {
      margin: 0;
      color: var(--sidebar-desc);
    }

    #help-box kbd {
      background: var(--toggle-bg);
      color: var(--toggle-text);
      padding: 2px 7px;
      border-radius: 4px;
      margin: 0 2px;
      font:
        12px/1 system-ui,
        sans-serif;
      font-weight: 600;
    }

    /* Config modal */
    #config-box {
      max-width: 360px;
    }

    #config-box fieldset {
      border: none;
      margin: 0;
      padding: 0;
    }

    #config-box legend {
      font-weight: 600;
      color: var(--sidebar-heading);
      margin-bottom: 8px;
    }

    #config-box p {
      margin: 0 0 12px;
      color: var(--sidebar-desc);
    }

    #config-box .segmented {
      display: flex;
      border: 1px solid var(--sidebar-border);
      border-radius: 6px;
      overflow: hidden;
    }

    #config-box .segmented label {
      flex: 1;
      text-align: center;
      padding: 8px 16px;
      cursor: pointer;
      border-right: 1px solid var(--sidebar-border);
      color: var(--sidebar-text);
      transition:
        background 0.15s,
        color 0.15s;
    }

    #config-box .segmented label:last-child {
      border-right: none;
    }

    #config-box .segmented label:hover {
      background: var(--toggle-hover);
    }

    #config-box .segmented input[type="radio"] {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    #config-box .segmented input[type="radio"]:checked + span {
      text-shadow: 0.015em 0 0 currentcolor;
    }

    #config-box .segmented label:has(input:checked) {
      background: var(--toggle-bg);
    }

    #config-save {
      display: block;
      margin: 16px auto 0;
    }

    /* Keyboard hint */
    #kbd-hint {
      position: fixed;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 950;
      font:
        12px/1 system-ui,
        sans-serif;
      color: var(--sidebar-levels);
      pointer-events: none;
      display: flex;
      gap: 12px;
      align-items: center;
      white-space: nowrap;
      background: var(--map-body-bg);
      padding: 8px 14px;
      border-radius: 8px;
    }

    #kbd-hint kbd {
      background: var(--toggle-bg);
      color: var(--toggle-text);
      padding: 2px 6px;
      border-radius: 3px;
      font-weight: 600;
    }

    #contact-link {
      pointer-events: auto;
      color: var(--sidebar-link);
      cursor: pointer;
      text-decoration: none;
    }

    #contact-link:hover {
      text-decoration: underline;
    }

    /* Contact modal */
    #contact-box {
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-width: 260px;
      max-width: 400px;
    }

    #contact-box h3 {
      margin: 0;
      color: var(--sidebar-heading);
      font-size: 16px;
    }

    #contact-box p,
    #contact-box hr {
      margin: 0;
      color: var(--sidebar-desc);
    }

    #contact-box a:not(.btn-primary) {
      color: var(--sidebar-link);
    }

    .btn-primary {
      display: inline-block;
      padding: 8px 20px;
      background: var(--sidebar-link);
      color: #fff;
      border: none;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
    }

    .btn-primary:hover {
      opacity: 0.85;
    }

    #contact-box .contact-cta {
      text-align: center;
    }

    #contact-box .contact-disclaimer {
      font-size: 12px;
      opacity: 0.8;
    }

    /* Updates bell button */
    #updates-bell {
      position: fixed;
      top: 12px;
      right: 12px;
      z-index: 850;
      background: var(--toggle-bg);
      color: var(--toggle-text);
      border: none;
      border-radius: 50%;
      width: 38px;
      height: 38px;
      font-size: 18px;
      line-height: 1;
      cursor: pointer;
      box-shadow: 0 2px 6px rgb(0 0 0 / 30%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #updates-bell:hover {
      background: var(--toggle-hover);
    }

    #updates-dot {
      display: none;
      width: 8px;
      height: 8px;
      background: #c0392b;
      border-radius: 50%;
      position: absolute;
      top: 4px;
      right: 4px;
    }

    #updates-dot.visible {
      display: block;
    }

    /* Auth button */
    #auth-btn {
      position: fixed;
      top: 12px;
      right: 58px;
      z-index: 850;
      background: var(--toggle-bg);
      color: var(--toggle-text);
      border: none;
      border-radius: 50%;
      width: 38px;
      height: 38px;
      font-size: 18px;
      line-height: 1;
      cursor: pointer;
      box-shadow: 0 2px 6px rgb(0 0 0 / 30%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #auth-btn:hover {
      background: var(--toggle-hover);
    }

    #auth-btn.signed-in {
      background: #2d6a4f;
      color: #fff;
    }

    #auth-btn.signed-in:hover {
      background: #245a42;
    }

    /* Auth modal */
    #auth-box {
      max-width: 360px;
      min-width: 280px;
    }

    #auth-box h3 {
      margin: 0 0 16px;
      color: var(--sidebar-heading);
      font-size: 16px;
    }

    .auth-buttons {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .auth-buttons button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 16px;
      border: 1px solid var(--sidebar-border);
      border-radius: 6px;
      background: #fff;
      color: var(--sidebar-text);
      font-size: 14px;
      cursor: pointer;
    }

    .auth-buttons button:hover {
      background: #f5f0e8;
    }

    .auth-buttons button svg {
      flex-shrink: 0;
    }

    #auth-signed-in {
      text-align: center;
    }

    #auth-signed-in .auth-user {
      font-weight: 600;
      color: var(--sidebar-heading);
      margin-bottom: 12px;
    }

    .sync-status {
      font-size: 12px;
      color: var(--sidebar-levels);
      margin-top: 8px;
    }

    #auth-signout-btn {
      margin-top: 12px;
      padding: 8px 20px;
      border: 1px solid var(--sidebar-border);
      border-radius: 6px;
      background: #fff;
      color: var(--sidebar-text);
      font-size: 13px;
      cursor: pointer;
    }

    #auth-signout-btn:hover {
      background: #f5f0e8;
    }

    /* Updates modal */
    #updates-box {
      max-width: 480px;
      max-height: 70vh;
      overflow-y: auto;
      min-width: 300px;
    }

    #updates-box h3 {
      margin: 0 0 16px;
      color: var(--sidebar-heading);
      font-size: 16px;
    }

    .update-group + .update-group {
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid var(--sidebar-border);
    }

    .update-date {
      color: var(--sidebar-levels);
      font-size: 12px;
      margin-bottom: 8px;
    }

    .update-entry {
      margin-bottom: 8px;
    }

    .update-entry:last-child {
      margin-bottom: 0;
    }

    .update-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
    }

    .update-type {
      display: inline-block;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 1px 6px;
      border-radius: 3px;
      background: var(--sidebar-border);
      color: var(--sidebar-levels);
    }

    .update-title {
      font-weight: 600;
      color: var(--sidebar-heading);
      font-size: 14px;
    }

    .update-desc {
      color: var(--sidebar-desc);
      font-size: 13px;
      margin-top: 2px;
    }

    @media (width <= 768px) {
      #map-container {
        touch-action: pan-x pan-y;
      }

      body.sidebar-open #map-container {
        width: 100%;
      }

      #sidebar {
        width: 100%;
        z-index: 960;
      }

      #search-results[data-open="true"] {
        position: fixed;
        top: 44px;
        left: 0;
        right: 0;
        max-height: 50vh;
        border-radius: 0 0 12px 12px;
      }
    }

    @media (pointer: coarse) {
      #kbd-hint {
        display: none;
      }
    }

    /* Adventure list below map */
    #adventure-list {
      scroll-margin-top: 52px;
      max-width: 720px;
      margin: 0 auto;
      padding: 32px 20px 48px;
      font:
        15px/1.6 system-ui,
        sans-serif;
      color: var(--sidebar-text);
    }

    #adventure-list h2 {
      color: var(--sidebar-heading);
      font-size: 20px;
      margin: 0 0 16px;
    }

    .adv-entry {
      border-bottom: 1px solid var(--sidebar-border);
      scroll-margin-top: 60px;
    }

    .adv-entry summary {
      display: flex;
      align-items: baseline;
      gap: 8px;
      padding: 12px 0;
      cursor: zoom-in;
      list-style: none;
    }

    .adv-entry summary::-webkit-details-marker {
      display: none;
    }

    .adv-entry summary::before {
      content: "\25B6";
      font-size: 10px;
      color: var(--sidebar-levels);
      transition: transform 0.15s;
    }

    .adv-entry[open] summary::before {
      transform: rotate(90deg);
    }

    .adv-name a {
      color: var(--sidebar-link);
      text-decoration: none;
      font-weight: 600;
    }

    .adv-name a:hover {
      text-decoration: underline;
    }

    .adv-official,
    .adv-ose {
      display: inline-block;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 1px 6px;
      border-radius: 3px;
      background: var(--sidebar-border);
      color: var(--sidebar-levels);
      vertical-align: middle;
      margin-left: 6px;
      cursor: default;
    }

    .adv-ose {
      background: #e8d5c4;
      color: #7a5232;
    }

    .adv-levels {
      color: var(--sidebar-levels);
      font-size: 13px;
      cursor: default;
    }

    .adv-meta {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 2px 8px;
    }

    .adv-location {
      color: var(--sidebar-levels);
      font-size: 13px;
      margin-left: auto;
      white-space: nowrap;
      cursor: default;
    }

    .adv-desc {
      padding: 0 0 16px 18px;
      color: var(--sidebar-desc);
    }

    .adv-desc p {
      margin: 0 0 8px;
    }

    .adv-desc p:last-child {
      margin-bottom: 0;
    }

    .adv-links {
      font-size: 13px;
    }

    .adv-links a {
      color: var(--sidebar-link);
    }

    .hex-link {
      color: var(--sidebar-link);
      text-decoration: none;
      cursor: pointer;
    }

    .hex-link:hover {
      text-decoration: underline;
    }

    @media (width <= 768px) {
      .adv-entry summary::before {
        padding: 16px;
        margin: -16px;
      }
    }

    #map-footer {
      text-align: center;
      padding: 16px 20px 56px;
      font:
        12px/1.6 system-ui,
        sans-serif;
      color: var(--sidebar-levels);
    }

    #map-footer a {
      color: var(--sidebar-levels);
      text-decoration: none;
    }

    #map-footer a:hover {
      text-decoration: underline;
    }

    #map-footer span {
      margin: 0 4px;
    }
