  function selectHex(hexId: string) {
    // Clear previous active hex outline
    if (currentHex && hexPolys[currentHex]) {
      hexPolys[currentHex].style.stroke = "";
      hexPolys[currentHex].style.strokeWidth = "";
    }
    if (activeHexShadow) {
      activeHexShadow.remove();
      activeHexShadow = null;
    }
    currentHex = hexId;
    if (hexId && hexPolys[hexId]) {
      const poly = hexPolys[hexId];
      poly.style.stroke = "#000000";
      poly.style.strokeWidth = "6";
      // Shadow clone: stroke-only copy behind the hex, blurred via SVG filter
      activeHexShadow = poly.cloneNode() as SVGPolygonElement;
      activeHexShadow.setAttribute("fill", "none");
      activeHexShadow.setAttribute("stroke", "rgba(0,0,0,0.8)");
      activeHexShadow.setAttribute("stroke-width", "20");
      activeHexShadow.setAttribute("filter", "url(#active-hex-blur)");
      activeHexShadow.style.pointerEvents = "none";
      poly.parentNode!.insertBefore(activeHexShadow, poly);
    }
    // If sidebar is open, refresh content (skip tracking — keyboard nav is noisy)
    if (hexId && sidebar.classList.contains("open")) {
      openSidebar(hexId, { skipTracking: true });
    }
  }

