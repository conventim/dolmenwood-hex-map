  async function saveNote(hexId: string) {
    const textarea = sidebarNotes.querySelector(
      ".notes-textarea",
    ) as HTMLTextAreaElement | null;
    const titleInput = sidebarNotes.querySelector(
      ".notes-title",
    ) as HTMLInputElement | null;
    const categorySelect = sidebarNotes.querySelector(
      ".notes-category",
    ) as HTMLSelectElement | null;
    const text = textarea ? textarea.value.trim() : "";
    const title = titleInput ? titleInput.value.trim() : "";
    const category = (categorySelect?.value || "news") as NoteCategory;
    if (!title || !text) {
      const firstInvalidField = !title ? titleInput : textarea;
      firstInvalidField?.setCustomValidity(
        !title ? "Title is required." : "Text is required.",
      );
      firstInvalidField?.reportValidity();
      firstInvalidField?.setCustomValidity("");
      return;
    }
    hexNotes[hexId] = { title, content: text, category };
    updateNoteTextLabel(hexId);
    updateNoteFill(hexId);
    notesEditMode = false;
    renderNotesSection(hexId);
    updateNoteBadge(hexId);
    if (sb) {
      if (text) {
        const { error } = await sb.from("hex_notes").upsert({
          hex_id: hexId,
          title,
          content: text,
          category,
          updated_at: new Date().toISOString(),
        });
        if (error) console.warn("Shared note save failed:", error.message);
      } else {
        const { error } = await sb
          .from("hex_notes")
          .delete()
          .eq("hex_id", hexId);
        if (error) console.warn("Shared note delete failed:", error.message);
      }
    }
    trackEvent("Referee note saved", {
      hex: hexId,
      action: text ? "save" : "delete",
    });
  }

  function cancelNoteEdit(hexId: string) {
    notesEditMode = false;
    renderNotesSection(hexId);
  }

  function openSidebar(hexId: string, { skipTracking = false } = {}) {
    if (!skipTracking) trackEvent("Hex opened", { hex: hexId });
    // sidebarTitle.innerHTML =
    //   hexId +
    //   (HEX_PAGES[hexId]
    //     ? ` <span class="hex-page-ref"><abbr data-tooltip="Dolmenwood Campaign Book">DCB</abbr> p. ${HEX_PAGES[hexId]}</span>`
    //     : "");
    sidebarTitle.innerHTML = hexId;
    updateSidebarExploration(hexId);
    const poiList = POIS[hexId];
    const mods = MODULES[hexId];
    const sidebarPois = document.getElementById("sidebar-pois") as HTMLElement;
    if (poiList && poiList.length > 0) {
      sidebarPois.innerHTML = poiList
        .map((p: any) => {
          const catLabel =
            p.category === "settlement"
              ? "Settlement"
              : p.category === "castle"
                ? "Castle / Keep"
                : "Point of Interest";
          return `<div class="poi"><h3>${p.name}</h3><div class="poi-meta">${catLabel}</div></div>`;
        })
        .join("");
    } else {
      sidebarPois.innerHTML = "";
    }
    notesEditMode = false;
    renderNotesSection(hexId);
    let html = "";
    if (mods && mods.length > 0) {
      html += [...mods]
        .sort((a, b) =>
          a.name.toLowerCase().localeCompare(b.name.toLowerCase()),
        )
        .map((m) => {
          const levelsHtml = `${m.levels ? `Levels ${m.levels}` : ""}${m.levels && m.estimated ? " · " : ""}${m.estimated ? `<span class="module-estimated" data-tooltip="Estimates are a guess based on whatever information is available (which is sometimes very little). You can contact me to correct this.">Estimated to be in this hex</span>` : ""}`;
          const linksHtml = [...m.links]
            .sort((a, b) =>
              a.label.toLowerCase().localeCompare(b.label.toLowerCase()),
            )
            .map((l) => `<a href="${l.url}" target="_blank">${l.label}</a>`)
            .join(" · ");
          return `
        <div class="module">
          <h3><a href="${preferredLink(m.links).url}" target="_blank">${m.name}</a>${m.official ? ` <span class="adv-official" data-tooltip="Published by Necrotic Gnome">Official</span>` : ""}${m.ose ? ` <span class="adv-ose" data-tooltip="Old-School Essentials adventure (not Dolmenwood-specific)">OSE</span>` : ""}</h3>
          <div class="module-meta">
            <span class="module-levels">${levelsHtml}</span>
            <span class="module-links">${linksHtml}</span>
          </div>
          <div class="module-desc">${m.descriptionHtml}</div>
        </div>
      `;
        })
        .join("");
    }
    sidebarContent.innerHTML = html;
    sidebarContent.querySelectorAll("a").forEach((a) => (a.target = "_blank"));
    sidebarContent.querySelectorAll(".module h3 a").forEach((a) => {
      a.addEventListener("click", () => {
        trackEvent("Module clicked", {
          name: a.textContent,
          link: "title",
          source: "sidebar",
        });
      });
    });
    sidebarContent.querySelectorAll(".module-links a").forEach((a) => {
      a.addEventListener("click", () => {
        trackEvent("Module clicked", {
          name: a.textContent,
          link: "store",
          source: "sidebar",
        });
      });
    });
    sidebarContent.querySelectorAll(".hex-link").forEach((a) => {
      a.addEventListener("click", () => {
        const hex = (a as HTMLAnchorElement).href?.split("hex=")[1];
        if (hex) trackEvent("Hex link clicked", { hex, source: "sidebar" });
      });
    });
    sidebar.classList.add("open");
    document.body.classList.add("sidebar-open");
    sidebar.focus();
    history.replaceState(null, "", "#hex=" + hexId);
  }

  // --- Deep-linking ---
  function openFromHash(isInitial?: boolean) {
    const match = location.hash.match(/^#hex=(\d{4})$/);
    if (match) {
      if (isInitial) trackEvent("Deep link arrival", { hex: match[1] });
      selectHex(match[1]);
      openSidebar(match[1]);
    }
  }

  window.addEventListener("hashchange", () => openFromHash());

  // --- SVG load: inject badges and click handlers ---
  (document.getElementById("map") as HTMLObjectElement).addEventListener(
    "load",
    function () {
      const svgDoc = this.contentDocument!;
      svgDocRef = svgDoc;
      const svgRoot = svgDoc.documentElement;
      const overlay =
        svgDoc.querySelector(".hex-overlay") ||
        svgDoc.querySelector('[class*="hex-overlay"]');
      if (!overlay) {
        console.error("No .hex-overlay group found in SVG");
        return;
      }
      overlayRef = overlay;

      // Strip fill:none from SVG's own style so fill attributes work
      svgDoc.querySelectorAll("style").forEach((s: HTMLStyleElement) => {
        s.textContent = (s.textContent ?? "").replace(
          /fill\s*:\s*none\s*;?/g,
          "",
        );
      });

      // Inject hover style into SVG
      const hoverStyle = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "style",
      );
      hoverStyle.textContent = `.hex-overlay polygon{pointer-events:all;cursor:pointer}.hex-overlay polygon:hover{fill:${HOVER_FILL};fill-opacity:1}.visited-hatch{pointer-events:none;fill:url(#crosshatch-visited);fill-opacity:1}.partial-hatch{pointer-events:none;fill:url(#stipple-partial);fill-opacity:1}`;
      svgRoot.prepend(hoverStyle);

      // Create SVG filters (native SVG <filter> for Safari compatibility).
      const defs = svgDoc.createElementNS("http://www.w3.org/2000/svg", "defs");

      // Green tint for geography
      const greenFilter = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "filter",
      );
      greenFilter.setAttribute("id", "light-green");
      greenFilter.setAttribute("color-interpolation-filters", "sRGB");
      const feGreen = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "feColorMatrix",
      );
      feGreen.setAttribute("type", "matrix");
      // Shift channels toward earthy green
      feGreen.setAttribute(
        "values",
        "0.35 0.30 0.10 0 0.02 " +
          "0.15 0.55 0.15 0 0.08 " +
          "0.10 0.12 0.22 0 0.00 " +
          "0    0    0    1 0",
      );
      greenFilter.appendChild(feGreen);
      defs.appendChild(greenFilter);

      // Drop shadow for hex polygons
      const shadowFilter = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "filter",
      );
      shadowFilter.setAttribute("id", "hex-shadow");
      // Blur source alpha into a shadow shape
      const feBlur = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "feGaussianBlur",
      );
      feBlur.setAttribute("in", "SourceAlpha");
      feBlur.setAttribute("stdDeviation", "4");
      feBlur.setAttribute("result", "blur");
      const feOffset = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "feOffset",
      );
      feOffset.setAttribute("in", "blur");
      feOffset.setAttribute("dx", "3");
      feOffset.setAttribute("dy", "4");
      feOffset.setAttribute("result", "shifted");
      // Tint the shadow
      const feFlood = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "feFlood",
      );
      feFlood.setAttribute("flood-color", "rgba(0,0,0,0.3)");
      feFlood.setAttribute("result", "color");
      const feIn = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "feComposite",
      );
      feIn.setAttribute("in", "color");
      feIn.setAttribute("in2", "shifted");
      feIn.setAttribute("operator", "in");
      feIn.setAttribute("result", "shadow");
      // Threshold SourceAlpha to fully opaque so semi-transparent fills
      // block the shadow completely instead of letting it bleed through.
      const feThreshold = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "feComponentTransfer",
      );
      feThreshold.setAttribute("in", "SourceAlpha");
      feThreshold.setAttribute("result", "opaque-mask");
      const feFuncA = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "feFuncA",
      );
      feFuncA.setAttribute("type", "linear");
      feFuncA.setAttribute("slope", "255");
      feFuncA.setAttribute("intercept", "0");
      feThreshold.appendChild(feFuncA);
      // Cut shadow using the opaque mask
      const feOut = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "feComposite",
      );
      feOut.setAttribute("in", "shadow");
      feOut.setAttribute("in2", "opaque-mask");
      feOut.setAttribute("operator", "out");
      feOut.setAttribute("result", "outer-shadow");
      // Merge: shadow behind, original hex on top
      const feMerge = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "feMerge",
      );
      const mn1 = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "feMergeNode",
      );
      mn1.setAttribute("in", "outer-shadow");
      const mn2 = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "feMergeNode",
      );
      mn2.setAttribute("in", "SourceGraphic");
      feMerge.appendChild(mn1);
      feMerge.appendChild(mn2);
      [feBlur, feOffset, feFlood, feIn, feThreshold, feOut, feMerge].forEach(
        (el) => shadowFilter.appendChild(el),
      );
      defs.appendChild(shadowFilter);

      // Blur filter for active hex shadow clone (stroke-only)
      const activeBlur = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "filter",
      );
      activeBlur.setAttribute("id", "active-hex-blur");
      const feActiveBlur = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "feGaussianBlur",
      );
      feActiveBlur.setAttribute("stdDeviation", "5");
      activeBlur.appendChild(feActiveBlur);
      defs.appendChild(activeBlur);

      // Crosshatch pattern for visited hexes
      const crosshatch = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "pattern",
      );
      crosshatch.setAttribute("id", "crosshatch-visited");
      crosshatch.setAttribute("patternUnits", "userSpaceOnUse");
      crosshatch.setAttribute("width", "20");
      crosshatch.setAttribute("height", "20");
      const line1 = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "line",
      );
      line1.setAttribute("x1", "0");
      line1.setAttribute("y1", "0");
      line1.setAttribute("x2", "20");
      line1.setAttribute("y2", "20");
      line1.setAttribute("stroke", "rgba(160,160,160,0.7)");
      line1.setAttribute("stroke-width", "5");
      crosshatch.appendChild(line1);
      defs.appendChild(crosshatch);

      // Stipple/dot pattern for partially explored hexes
      const stipple = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "pattern",
      );
      stipple.setAttribute("id", "stipple-partial");
      stipple.setAttribute("patternUnits", "userSpaceOnUse");
      stipple.setAttribute("width", "18");
      stipple.setAttribute("height", "18");
      const dotFill = "rgba(80,180,170,0.8)";
      [
        [4, 4],
        [13, 4],
        [8.5, 10],
        [4, 16],
        [13, 16],
      ].forEach(([cx, cy]) => {
        const dot = svgDoc.createElementNS(
          "http://www.w3.org/2000/svg",
          "circle",
        );
        dot.setAttribute("cx", String(cx));
        dot.setAttribute("cy", String(cy));
        dot.setAttribute("r", "4.5");
        dot.setAttribute("fill", dotFill);
        stipple.appendChild(dot);
      });
      defs.appendChild(stipple);

      svgRoot.prepend(defs);

      // Wrap hex polygons in a group so the shadow filter operates on the
      // composite shape — shadows only appear on outer edges, not between hexes.
      const hexGroup = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "g",
      );
      hexGroup.setAttribute("filter", "url(#hex-shadow)");
      overlay.querySelectorAll("[data-hex]").forEach((poly: Element) => {
        hexGroup.appendChild(poly);
      });
      overlay.insertBefore(hexGroup, overlay.firstChild);

      // Forward keyboard events from embedded SVG to parent handler
      // svgDoc.addEventListener("keydown", handleKeydown);

      // Mute geography/grid but not hex numbers or badges
      // Apply dark-mode inversion only to grid + geography, not labels/badges
      const clipGroup = overlay.parentElement!;
      const grid = clipGroup.children[0] as SVGElement | null; // <path> grid
      const geo = clipGroup.children[1] as SVGElement | null; // <g> geography
      const labels = clipGroup.children[2] as SVGElement | null; // <g> hex labels

      // Visited-hatch group: sits between hex polygons and labels
      visitedGroup = svgDoc.createElementNS("http://www.w3.org/2000/svg", "g");
      if (labels) {
        labels.parentElement!.insertBefore(visitedGroup, labels);
      } else {
        overlay.appendChild(visitedGroup);
      }

      const POI_COLOR = ACCENT_GREEN;
      const poiMarkers: SVGElement[] = [];
      function applyMapStyles() {
        if (grid) {
          grid.style.strokeWidth = "3";
        }
        if (geo) {
          geo.setAttribute("filter", "url(#light-green)");
          geo.style.opacity = "0.9";
        }
        if (labels) {
          labels.style.fill = "#000000";
          labelBgs.forEach(({ rect }) => {
            rect.setAttribute("fill", "rgba(211,211,211,0.75)");
          });
        }
        poiMarkers.forEach((m) => m.setAttribute("fill", POI_COLOR));
      }

      // Label sizing + background rects
      const labelBgs: Array<{ rect: SVGRectElement; text: SVGTextElement }> =
        [];
      if (labels) {
        let labelSize =
          parseInt(localStorage.getItem("map-label-size") ?? "", 10) ||
          DEFAULT_LABEL_SIZE;
        labels.style.fontSize = labelSize + "px";
        // Safari doesn't support dominant-baseline:hanging reliably.
        // Switch to alphabetic baseline with a dy shift instead.
        labels.style.dominantBaseline = "auto";
        labels.querySelectorAll("text").forEach((t: Element) => {
          t.setAttribute("dy", "0.8em");
        });

        const bgGroup = svgDoc.createElementNS(
          "http://www.w3.org/2000/svg",
          "g",
        );
        clipGroup.insertBefore(bgGroup, labels);

        const PAD = 6;
        labels.querySelectorAll("text").forEach((t: SVGTextElement) => {
          const rect = svgDoc.createElementNS(
            "http://www.w3.org/2000/svg",
            "rect",
          );
          rect.setAttribute("rx", "4");
          bgGroup.appendChild(rect);
          labelBgs.push({ rect, text: t });
        });

        function updateLabelBgs() {
          labelBgs.forEach(({ rect, text }) => {
            const bb = text.getBBox();
            rect.setAttribute("x", String(bb.x - PAD));
            rect.setAttribute("y", String(bb.y - PAD));
            rect.setAttribute("width", String(bb.width + PAD * 2));
            rect.setAttribute("height", String(bb.height + PAD * 2));
          });
        }
        updateLabelBgs();

        setLabelSize = function (size: number) {
          labelSize = Math.max(12, Math.min(120, size));
          labels.style.fontSize = labelSize + "px";
          localStorage.setItem("map-label-size", String(labelSize));
          schedulePush();
          updateLabelBgs();
        };
        // getLabelSize = function () {
        //   return labelSize;
        // };
      }

      // --- POI markers (rendered first so badges appear on top) ---
      const POI_SIZE = 84;
      // Two-house silhouette, centered at origin (~38x32 units)
      const HOUSE_PATH =
        "M -18,12 V 2 L -10,-6 L -2,2 V 12 Z M -13,12 V 7 A 3,3 0 0,1 -7,7 V 12 Z M 0,12 V -2 L 10,-12 L 20,-2 V 12 Z M 7,12 V 5 A 3,3 0 0,1 13,5 V 12 Z";
      // Castle with crenellations and central tower, arch cutout
      const CASTLE_PATH =
        "M -20,14 V -2 H -18 V -8 H -14 V -2 H -11 V -8 H -7 V -2 H -6 L 0,-16 L 6,-2 H 7 V -8 H 11 V -2 H 14 V -8 H 18 V -2 H 20 V 14 Z M -2.5,14 V 6 A 2.5,2.5 0 0,1 2.5,6 V 14 Z";
      // 5-point star, centered at origin (~24x24 units)
      const STAR_PATH =
        "M 0,-12 L 3.5,-4 L 12,-4 L 5.5,2 L 7.5,11 L 0,6 L -7.5,11 L -5.5,2 L -12,-4 L -3.5,-4 Z";
      const POI_PATHS = {
        settlement: HOUSE_PATH,
        castle: CASTLE_PATH,
        poi: STAR_PATH,
      };

      Object.keys(POIS).forEach((hexId) => {
        const poly = svgDoc.querySelector(`[data-hex="${hexId}"]`);
        if (!poly) return;

        const pts = poly
          .getAttribute("points")!
          .trim()
          .split(/\s+/)
          .map((p: string) => {
            const [x, y] = p.split(",").map(Number);
            return { x, y };
          });
        const cx =
          pts.reduce((s: number, p: { x: number }) => s + p.x, 0) / pts.length;
        const cy =
          pts.reduce((s: number, p: { y: number }) => s + p.y, 0) / pts.length;

        const hasBadge = !!MODULES[hexId];
        const poiCount = POIS[hexId].length;
        const totalItems = poiCount + (hasBadge ? 1 : 0);
        const SPACING = 85;
        const startX = cx - ((totalItems - 1) * SPACING) / 2;

        POIS[hexId].forEach((poi: any, idx: number) => {
          const bx = startX + idx * SPACING;
          const by = cy;
          const pathData =
            POI_PATHS[poi.category as keyof typeof POI_PATHS] || STAR_PATH;
          const scale = POI_SIZE / 36;

          const marker = svgDoc.createElementNS(
            "http://www.w3.org/2000/svg",
            "path",
          );
          marker.setAttribute("d", pathData);
          marker.setAttribute(
            "transform",
            `translate(${bx} ${by}) scale(${scale})`,
          );
          marker.setAttribute("fill-rule", "evenodd");
          marker.setAttribute("stroke", "none");
          marker.setAttribute("pointer-events", "none");
          poiMarkers.push(marker);
          overlay.appendChild(marker);
        });
      });

      // Set initial POI colors based on current theme
      applyMapStyles();

      // --- Module badges (rendered after POIs so they appear on top) ---
      Object.keys(MODULES).forEach((hexId) => {
        const poly = svgDoc.querySelector(`[data-hex="${hexId}"]`);
        if (!poly) {
          console.warn("No polygon for hex", hexId);
          return;
        }

        const count = MODULES[hexId].length;

        const pts = poly
          .getAttribute("points")!
          .trim()
          .split(/\s+/)
          .map((p: string) => {
            const [x, y] = p.split(",").map(Number);
            return { x, y };
          });
        const cx =
          pts.reduce((s: number, p: { x: number }) => s + p.x, 0) / pts.length;
        const cy =
          pts.reduce((s: number, p: { y: number }) => s + p.y, 0) / pts.length;

        const poiCount = POIS[hexId] ? POIS[hexId].length : 0;
        const totalItems = poiCount + 1;
        const SPACING = 85;
        const startX = cx - ((totalItems - 1) * SPACING) / 2;
        const bx = startX + poiCount * SPACING;
        const by = cy;

        const g = svgDoc.createElementNS("http://www.w3.org/2000/svg", "g");
        g.setAttribute("class", "module-badge");
        g.setAttribute("data-badge-hex", hexId);
        g.setAttribute("pointer-events", "none");

        const circle = svgDoc.createElementNS(
          "http://www.w3.org/2000/svg",
          "circle",
        );
        circle.setAttribute("cx", String(bx));
        circle.setAttribute("cy", String(by));
        circle.setAttribute("r", "36");
        circle.setAttribute("fill", MODULE_BADGE_COLOR);
        circle.setAttribute("stroke", "#fff");
        circle.setAttribute("stroke-width", "3");

        const text = svgDoc.createElementNS(
          "http://www.w3.org/2000/svg",
          "text",
        );
        text.setAttribute("x", String(bx));
        text.setAttribute("y", String(by));
        text.setAttribute("text-anchor", "middle");
        text.setAttribute("dominant-baseline", "central");
        text.setAttribute("fill", "#fff");
        text.setAttribute("font-size", "40");
        text.setAttribute("font-family", "system-ui, sans-serif");
        text.setAttribute("font-weight", "bold");
        text.textContent = String(count);

        g.appendChild(circle);
        g.appendChild(text);
        overlay.appendChild(g);
      });

      svgDoc.querySelectorAll("[data-hex]").forEach((poly) => {
        const hexId = (poly as HTMLElement).dataset.hex!;
        hexPolys[hexId] = poly as unknown as SVGPolygonElement;
        let mobileTooltipHex: string | null = null;

        // Use a neutral base; note colors are rendered in a separate overlay.
        poly.setAttribute("fill", NOTELESS_HEX_COLOR);
        poly.setAttribute("fill-opacity", "0.4");

        const poiList = POIS[hexId];
        const mods = MODULES[hexId];
        const showTooltip = (event: Event) => {
          const note = hexNotes[hexId];
          if (!note) {
            tooltip.style.display = "none";
            tooltip.style.border = "none";
            return;
          }
          const e = event as MouseEvent | PointerEvent;
          let html = `<div class="tt-hex">${hexId}</div>`;
          const vState = visitedHexes.get(hexId);
          if (vState) {
            const label =
              vState === "partial" ? "Partially explored" : "Fully explored";
            html += `<div class="tt-state">${label}</div>`;
          }
          if (poiList) {
            html += poiList
              .map((p: any) => {
                const catLabel =
                  p.category === "settlement"
                    ? "Settlement"
                    : p.category === "castle"
                      ? "Castle / Keep"
                      : "POI";
                return `<div><span class="tt-name">${p.name}</span><span class="tt-cat">${catLabel}</span></div>`;
              })
              .join("");
          }
          if (mods) {
            html += mods
              .map((m: any) => {
                let line = `<span class="tt-name">${m.name}</span>`;
                if (m.levels)
                  line += `<span class="tt-level">Lv ${m.levels}</span>`;
                return `<div>${line}</div>`;
              })
              .join("");
          }
          tooltip.style.border = `2px solid ${NOTE_CATEGORY_COLORS[note.category]}`;
          html += `<div><span class="tt-name" style="color:#000">${note.content}</span></div>`;
          if (!html) return;
          tooltip.innerHTML = html;
          tooltip.style.display = "block";
          const rect = mapObj.getBoundingClientRect();
          const me = e as MouseEvent;
          tooltip.style.left = rect.left + me.clientX + 12 + "px";
          tooltip.style.top = rect.top + me.clientY - 12 + "px";
        };
        poly.addEventListener("mouseenter", showTooltip);
        poly.addEventListener("pointerup", (e) => {
          if ((e as PointerEvent).pointerType === "touch") {
            if (touchGestureMoved) return;
            if (!hexNotes[hexId]) {
              mobileTooltipHex = hexId;
              selectHex(hexId);
              openSidebar(hexId);
              notesEditMode = true;
              renderNotesSection(hexId);
              trackEvent("Referee note started", { hex: hexId });
              return;
            }
            mobileTooltipHex = mobileTooltipHex === hexId ? null : hexId;
          }
          showTooltip(e);
        });
        poly.addEventListener("mousemove", (e) => {
          if (tooltip.style.display === "none") return;
          const me = e as MouseEvent;
          const rect = mapObj.getBoundingClientRect();
          tooltip.style.left = rect.left + me.clientX + 12 + "px";
          tooltip.style.top = rect.top + me.clientY - 12 + "px";
        });
        poly.addEventListener("mouseleave", () => {
          tooltip.style.display = "none";
        });

        poly.addEventListener("click", (e) => {
          if (touchGestureMoved) {
            e.preventDefault();
            return;
          }
          if (mobileTooltipHex === hexId) {
            e.preventDefault();
            return;
          }
          tooltip.style.display = "none";
          selectHex(hexId);
          openSidebar(hexId);
        });
      });
      // allHexIds = Object.keys(hexPolys).sort();

      noteLabelGroup = svgDoc.createElementNS(
        "http://www.w3.org/2000/svg",
        "g",
      );
      noteLabelGroup.setAttribute("class", "test-hex-labels");
      noteLabelGroup.setAttribute("pointer-events", "none");
      overlay.appendChild(noteLabelGroup);

      Object.keys(hexPolys).forEach(updateNoteTextLabel);
      noteFillGroup = svgDoc.createElementNS("http://www.w3.org/2000/svg", "g");
      noteFillGroup.setAttribute("class", "note-fills");
      noteFillGroup.setAttribute("pointer-events", "none");
      noteLabelGroup.parentNode!.insertBefore(noteFillGroup, noteLabelGroup);
      Object.keys(hexPolys).forEach(updateNoteFill);

      // --- DM Note badges ---
      Object.keys(hexNotes).forEach((hexId) => updateNoteBadge(hexId));

      // Apply visited state from localStorage
      visitedHexes.forEach((state, hexId) => applyVisitedOverlay(hexId, state));

      // --- Search ---
      const hexSearch = document.getElementById(
        "hex-search",
      ) as HTMLInputElement;
      const searchClear = document.getElementById(
        "search-clear",
      ) as HTMLButtonElement;

      const PLACEHOLDER_FULL = hexSearch.placeholder;
      const PLACEHOLDER_SHORT = "\u{1F50D} Search\u2026";
      function updateSearchPlaceholder() {
        hexSearch.placeholder =
          window.innerWidth <= 500 ? PLACEHOLDER_SHORT : PLACEHOLDER_FULL;
      }
      updateSearchPlaceholder();
      window.addEventListener("resize", updateSearchPlaceholder);
      updateSearchClearButton();

      searchClear.addEventListener("click", () => {
        hexSearch.value = "";
        hexSearch.dispatchEvent(new Event("input"));
        hexSearch.focus();
      });

      hexSearch.addEventListener("input", () => {
        const q = hexSearch.value;
        const isNumeric = /^\d+$/.test(q);
        updateSearchClearButton();

        // Clear nav cursor when searching
        if (currentHex && hexPolys[currentHex]) {
          hexPolys[currentHex].style.stroke = "";
          hexPolys[currentHex].style.strokeWidth = "";
        }
        if (activeHexShadow) {
          activeHexShadow.remove();
          activeHexShadow = null;
        }
        currentHex = null;

        // Highlight hex polygons for numeric queries
        if (isNumeric && q.length > 0) {
          Object.entries(hexPolys).forEach(([hexId, poly]) => {
            const match = numericHexMatches(hexId, q);
            const hasNote = Boolean(hexNotes[hexId]);
            poly.style.fill = match && !hasNote ? SEARCH_HIGHLIGHT : "";
            poly.style.fillOpacity = match && !hasNote ? "1" : "";
            poly.style.stroke = match && hasNote ? SEARCH_HIGHLIGHT_STROKE : "";
            poly.style.strokeWidth =
              match && hasNote ? SEARCH_HIGHLIGHT_STROKE_WIDTH : "";
          });
        } else {
          clearHexHighlights();
        }

        // Search and render dropdown
        const results = searchMapEntries(q);
        renderSearchResults(results);
      });

      hexSearch.addEventListener("keydown", (e) => {
        if (!isSearchDropdownOpen()) {
          // Legacy: Enter on 4-digit hex still works even without dropdown
          if (e.key === "Enter" && /^\d{4}$/.test(hexSearch.value)) {
            const hexId = hexSearch.value;
            trackEvent("Search", { query: hexId, type: "hex", hex: hexId });
            clearHexHighlights();
            if (hexPolys[hexId]) selectHex(hexId);
            if (POIS[hexId] || MODULES[hexId]) {
              openSidebar(hexId);
            }
            hexSearch.value = "";
            hexSearch.blur();
          }
          return;
        }

        if (e.key === "ArrowDown") {
          e.preventDefault();
          const next =
            searchSelectedIdx < currentSearchResults.length - 1
              ? searchSelectedIdx + 1
              : 0;
          updateSearchSelection(next);
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          const prev =
            searchSelectedIdx > 0
              ? searchSelectedIdx - 1
              : currentSearchResults.length - 1;
          updateSearchSelection(prev);
        } else if (e.key === "Enter") {
          e.preventDefault();
          if (
            searchSelectedIdx >= 0 &&
            currentSearchResults[searchSelectedIdx]
          ) {
            selectSearchResult(currentSearchResults[searchSelectedIdx]);
          } else if (currentSearchResults.length > 0) {
            selectSearchResult(currentSearchResults[0]);
          }
        } else if (e.key === "Escape") {
          e.preventDefault();
          e.stopPropagation();
          closeSearchDropdown();
        }
      });

      // Close search dropdown on click outside
      document.addEventListener("click", (e) => {
        const container = document.getElementById("search-container")!;
        if (isSearchDropdownOpen() && !container.contains(e.target as Node)) {
          closeSearchDropdown();
        }
      });

      // Open from hash after badges/handlers are ready (skip animation)
      sidebar.style.transition = "none";
      openFromHash(true);
      requestAnimationFrame(() => {
        sidebar.style.transition = "";
      });
    },
  );

  document.querySelectorAll("#adventure-list .adv-name a").forEach((a) => {
    a.addEventListener("click", () => {
      trackEvent("Module clicked", {
        name: a.textContent,
        link: "title",
        source: "adventure-list",
      });
    });
  });
  document.querySelectorAll("#adventure-list .hex-link").forEach((a) => {
    a.addEventListener("click", () => {
      const hex = (a as HTMLAnchorElement).href?.split("hex=")[1];
      if (hex)
        trackEvent("Hex link clicked", { hex, source: "adventure-list" });
    });
  });
  document.querySelectorAll("#adventure-list .adv-links a").forEach((a) => {
    a.addEventListener("click", () => {
      trackEvent("Module clicked", {
        name: a.textContent,
        link: "store",
        source: "adventure-list",
      });
    });
  });
  document.querySelectorAll("#adventure-list .adv-entry").forEach((details) => {
    details.addEventListener("toggle", () => {
      if ((details as HTMLDetailsElement).open) {
        const name = details.querySelector(".adv-name a")?.textContent || "";
        trackEvent("Adventure expanded", { name });
      }
    });
  });
  // Prevent levels, location, and official badge from toggling the details
  document
    .querySelectorAll(
      "#adventure-list .adv-levels, #adventure-list .adv-location, #adventure-list .adv-official, #adventure-list .adv-ose",
    )
    .forEach((el) => {
      el.addEventListener("click", (e) => {
        if (!(e.target as HTMLElement)?.closest(".hex-link"))
          e.preventDefault();
      });
    });

  // Track + hide "See all modules" link
  // const seeModules = document.getElementById("see-modules") as HTMLElement;
  // seeModules.addEventListener("click", () => {
  //   trackEvent("All modules clicked");
  // });
  // mapContainer.addEventListener(
  //   "scroll",
  //   () => {
  //     seeModules.style.display = mapContainer.scrollTop > 100 ? "none" : "";
  //   },
  //   { passive: true },
  // );
</script>
