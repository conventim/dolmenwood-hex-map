          NOTE_CATEGORY_COLORS[categorySelect.value as NoteCategory];
      };
      categorySelect.addEventListener("change", updateCategoryColor);
      updateCategoryColor();
      textarea.focus();
      textarea.addEventListener("keydown", (e: KeyboardEvent) => {
        if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
