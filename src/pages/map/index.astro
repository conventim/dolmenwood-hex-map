  function updateProgress() {
    const { visited, partial } = countProgress(visitedHexes, HEX_PAGES);
    const progressEl = document.getElementById("hex-progress") as HTMLElement;
    if (visited === 0 && partial === 0) {
      progressEl.style.display = "none";
      return;
    }
    const parts: string[] = [];
    if (visited > 0) parts.push(`${visited} fully explored`);
    if (partial > 0) parts.push(`${partial} partially explored`);
    progressEl.style.display = "";
    const noun = visited + partial === 1 ? " hex." : " hexes.";
    document.getElementById("progress-text")!.textContent =
      parts.join(" and ") + noun;
  }
  updateProgress();

  const visitedOverlays: Record<string, Element> = {}; // hexId -> overlay element
  let visitedGroup: Element | null = null; // <g> for overlays, created during SVG init
  function applyVisitedOverlay(
    hexId: string,
    state: string | null | undefined,
  ) {
    const poly = hexPolys[hexId];
    if (!poly || !visitedGroup) return;
    // Remove existing overlay first
    if (visitedOverlays[hexId]) {
      visitedOverlays[hexId].remove();
      delete visitedOverlays[hexId];
    }
    if (!state) return;
    const el = poly.cloneNode(false) as SVGPolygonElement;
    el.removeAttribute("data-hex");
    el.removeAttribute("class");
    el.classList.add(state === "partial" ? "visited-hatch" : "partial-hatch");
    el.removeAttribute("fill-opacity");
    visitedGroup.appendChild(el);
    visitedOverlays[hexId] = el;
  }

