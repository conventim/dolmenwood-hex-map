      }

      <p class="contact-disclaimer">
        This is a fan project, not affiliated with Necrotic Gnome. I'm just
        trying to help people enjoy the world of Dolmenwood.
      </p>
      <button id="contact-close" class="modal-close" aria-label="Close contact"
        >&times;</button
      >
    </div>
  </div>
  <div id="tooltip"></div>
  <div id="attr-tooltip"></div>
  <div id="sidebar" tabindex="-1">
    <div id="sidebar-header">
      <div class="header-row">
        <h2 id="sidebar-title">Hex Details</h2>
        <button id="sidebar-close" aria-label="Close sidebar">&times;</button>
      </div>
      <div id="sidebar-pois"></div>
      <div id="sidebar-exploration"></div>
    </div>
    <div id="sidebar-notes"></div>
    <div id="sidebar-content"></div>
  </div>
</Base>

<script
  is:inline
  define:vars={{
    modulesJson,
    poisJson,
    hexColorsJson,
    hexPagesJson,
    updatesJson,
    locationModulesJson,
  }}
>
  window.__MAP_DATA__ = {
    modules: JSON.parse(modulesJson),
    pois: JSON.parse(poisJson),
    hexColors: JSON.parse(hexColorsJson),
    hexPages: JSON.parse(hexPagesJson),
    updates: JSON.parse(updatesJson),
    locationModules: JSON.parse(locationModulesJson),
  };
</script>

<script>
  /* eslint-disable @typescript-eslint/no-explicit-any */
  import { renderMarkdown } from "../../lib/map/markdown";
  import {
    buildSearchIndex,
    numericHexMatches,
    searchEntries,
  } from "../../lib/map/search";
  import { countProgress } from "../../lib/map/hex-nav";
  import {
    SUPABASE_URL,
    SUPABASE_PUBLISHABLE_KEY,
    SUPABASE_ENABLED,
  } from "../../lib/config";

  declare global {
    interface Window {
      __MAP_DATA__: any;
      stonks?: { event: (name: string, props?: Record<string, any>) => void };
      supabase?: any;
    }
  }

  const {
    modules: MODULES,
    pois: POIS,
    hexColors: HEX_COLORS,
    hexPages: HEX_PAGES,
    updates: UPDATES,
    locationModules: LOCATION_MODULES,
  } = window.__MAP_DATA__;

  function trackEvent(name: string, props: Record<string, any> = {}) {
    if (window.stonks) window.stonks.event(name, props);
  }

  // --- Supabase init (deferred) ---
  // On dolmenwood subdomain, CloudFront prefixes /map, so the consent page is at /oauth/consent.
  // On the main domain, the full /map/oauth/consent path is needed.
  const consentPath = window.location.host.startsWith("dolmenwood.")
    ? "/oauth/consent"
    : "/map/oauth/consent";
  let sb: any = null;
  let isSyncing = false;
  let pushTimer: ReturnType<typeof setTimeout> | null = null;

  function initSupabase() {
    if (!window.supabase) return;
    sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);
    initSharedNotes();
    sb.auth.onAuthStateChange((event: any, session: any) => {
      if (event === "SIGNED_IN" || event === "INITIAL_SESSION") {
        if (session?.user) {
          updateAuthUI(session.user);
          syncFromCloud(session.user);
        }
      } else if (event === "SIGNED_OUT") {
        updateAuthUI(null);
      }
    });
    sb.auth.getSession().then(({ data: { session } }: any) => {
      if (session?.user) {
        updateAuthUI(session.user);
      }
    });
  }

  const DEFAULT_LABEL_SIZE = 54;
  const SVG_ASPECT = 4535 / 3396; // from map.svg viewBox
  const MAP_MIN_WIDTH = 980;
  const MAX_MOBILE_ZOOM = 3;
  const mobileQuery = window.matchMedia("(max-width: 768px)");
  let mobileZoom = 1;

  // --- Map sizing (scale with browser zoom) ---
  const mapContainer = document.getElementById("map-container") as HTMLElement;
  const mapObj = document.getElementById("map") as HTMLElement;

  // devicePixelRatio changes with browser zoom but is NOT affected by
  // devtools open/close, so it's a reliable baseline for zoom detection.
  const baseDPR = window.devicePixelRatio;

  function updateMapSize() {
    if (mobileQuery.matches) {
      const w = Math.max(MAP_MIN_WIDTH, mapContainer.clientWidth) * mobileZoom;
      mapObj.style.width = w + "px";
      mapObj.style.height = w / SVG_ASPECT + "px";
    } else {
      const zoom = window.devicePixelRatio / baseDPR;
      mapObj.style.width = mapContainer.clientWidth * zoom + "px";
      mapObj.style.height = mapContainer.clientHeight * zoom + "px";
    }
  }

  new ResizeObserver(() => updateMapSize()).observe(mapContainer);
  updateMapSize();

  // --- Pinch-to-zoom on mobile ---
  let lastPinchDist = 0;
  let touchStartX = 0;
  let touchStartY = 0;
  let touchGestureMoved = false;
  let touchGestureResetTimer: ReturnType<typeof setTimeout> | null = null;

  mapContainer.addEventListener("pointerdown", (e) => {
    if (e.pointerType !== "touch") return;
    touchStartX = e.clientX;
    touchStartY = e.clientY;
    touchGestureMoved = false;
    if (touchGestureResetTimer) clearTimeout(touchGestureResetTimer);
  });

  mapContainer.addEventListener("pointermove", (e) => {
    if (e.pointerType !== "touch" || touchGestureMoved) return;
    touchGestureMoved =
      Math.hypot(e.clientX - touchStartX, e.clientY - touchStartY) > 8;
  });

  mapContainer.addEventListener("pointerup", (e) => {
    if (e.pointerType !== "touch") return;
    touchGestureResetTimer = setTimeout(() => {
      touchGestureMoved = false;
      touchGestureResetTimer = null;
    }, 300);
  });

  mapContainer.addEventListener("pointercancel", () => {
    touchGestureMoved = true;
  });

  mapContainer.addEventListener(
    "touchstart",
    (e) => {
      if (e.touches.length === 2) {
        const dx = e.touches[0].clientX - e.touches[1].clientX;
        const dy = e.touches[0].clientY - e.touches[1].clientY;
        lastPinchDist = Math.hypot(dx, dy);
      }
    },
    { passive: true },
  );

  mapContainer.addEventListener(
    "touchmove",
    (e) => {
      if (e.touches.length !== 2) return;
      const dx = e.touches[0].clientX - e.touches[1].clientX;
      const dy = e.touches[0].clientY - e.touches[1].clientY;
      const dist = Math.hypot(dx, dy);
      if (!lastPinchDist) return;

      const scale = dist / lastPinchDist;
      const oldZoom = mobileZoom;
      mobileZoom = Math.min(MAX_MOBILE_ZOOM, Math.max(1, mobileZoom * scale));

      if (mobileZoom !== oldZoom) {
        e.preventDefault();
        // Zoom centered on pinch midpoint
        const midX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
        const midY = (e.touches[0].clientY + e.touches[1].clientY) / 2;
        const scrollX = mapContainer.scrollLeft + midX;
        const scrollY = mapContainer.scrollTop + midY;
        const ratio = mobileZoom / oldZoom;

        updateMapSize();

        mapContainer.scrollLeft = scrollX * ratio - midX;
        mapContainer.scrollTop = scrollY * ratio - midY;
      }

      lastPinchDist = dist;
    },
    { passive: false },
  );

  mapContainer.addEventListener("touchend", () => {
    lastPinchDist = 0;
  });

  // Named color constants
  const ACCENT_GREEN = "#2d6a4f";
  const HOVER_FILL = "rgba(45,106,79,0.25)";
  const SEARCH_HIGHLIGHT = "rgba(255,183,77,0.55)";
  const SEARCH_HIGHLIGHT_STROKE = "#ff8f00";
  const SEARCH_HIGHLIGHT_STROKE_WIDTH = "12";
  const MODULE_BADGE_COLOR = "#a0522d";
  const NOTELESS_HEX_COLOR = "#d3d3d3";
  const NOTE_CATEGORY_COLORS = {
    explored: "#2d6a4f",
    news: "#ffd000",
    useful_places: "#2b6cb0",
  } as const;
  type NoteCategory = keyof typeof NOTE_CATEGORY_COLORS;
  interface SharedNote {
    title: string;
    content: string;
    category: NoteCategory;
  }

  // --- Search index ---
  const SEARCH_INDEX = buildSearchIndex(
    HEX_COLORS,
    POIS,
    MODULES,
    LOCATION_MODULES,
  );

  const tooltip = document.getElementById("tooltip") as HTMLElement;

  // --- data-tooltip hover tooltips ---
  const attrTooltip = document.getElementById("attr-tooltip") as HTMLElement;
  document.addEventListener("mouseover", (e) => {
    const el = (e.target as HTMLElement)?.closest("[data-tooltip]");
    if (!el) {
      attrTooltip.style.display = "none";
      return;
    }
    attrTooltip.textContent = (el as HTMLElement).dataset.tooltip ?? "";
    attrTooltip.style.display = "block";
    const r = el.getBoundingClientRect();
    let left = r.left;
    let top = r.top - attrTooltip.offsetHeight - 4;
    if (top < 0) top = r.bottom + 4;
    if (left + attrTooltip.offsetWidth > window.innerWidth)
      left = window.innerWidth - attrTooltip.offsetWidth - 4;
    if (left < 4) left = 4;
    attrTooltip.style.left = left + "px";
    attrTooltip.style.top = top + "px";
  });
  document.addEventListener("mouseout", (e) => {
    if ((e.target as HTMLElement)?.closest("[data-tooltip]"))
      attrTooltip.style.display = "none";
  });

  const sidebar = document.getElementById("sidebar") as HTMLElement;
  const sidebarTitle = document.getElementById("sidebar-title") as HTMLElement;
  const sidebarContent = document.getElementById(
    "sidebar-content",
  ) as HTMLElement;

  document
    .getElementById("sidebar-close")!
    .addEventListener("click", closeSidebar);
  const helpOverlay = document.getElementById("help-overlay") as HTMLElement;
  function toggleHelp() {
    if (helpOverlay.style.display === "none")
      trackEvent("kbd shortcuts opened");
    helpOverlay.style.display =
      helpOverlay.style.display === "none" ? "flex" : "none";
  }
  document.getElementById("help-close")!.addEventListener("click", toggleHelp);
  helpOverlay.addEventListener("click", (e) => {
    if (e.target === helpOverlay) toggleHelp();
  });

  const deleteNoteOverlay = document.getElementById(
    "delete-note-overlay",
  ) as HTMLElement;
  let pendingDeleteHex: string | null = null;
  function openDeleteNoteConfirmation(hexId: string) {
    pendingDeleteHex = hexId;
    deleteNoteOverlay.style.display = "flex";
  }
  function closeDeleteNoteConfirmation() {
    pendingDeleteHex = null;
    deleteNoteOverlay.style.display = "none";
  }
  document
    .getElementById("delete-note-cancel")!
    .addEventListener("click", closeDeleteNoteConfirmation);
  document
    .getElementById("delete-note-confirm")!
    .addEventListener("click", async () => {
      if (!pendingDeleteHex) return;
      const hexId = pendingDeleteHex;
      closeDeleteNoteConfirmation();
      await deleteNote(hexId);
      renderNotesSection(hexId);
      updateNoteBadge(hexId);
    });
  deleteNoteOverlay.addEventListener("click", (e) => {
    if (e.target === deleteNoteOverlay) closeDeleteNoteConfirmation();
  });

  // --- Store preference ---
  const STORE_PREF_KEY = "map-store-pref";
  const STORE_DOMAINS: Record<string, string> = {
    itch: "itch.io",
    drivethrurpg: "drivethrurpg.com",
  };
  function getStorePref() {
    return localStorage.getItem(STORE_PREF_KEY);
  }
  // Default to itch.io for links even when no preference is saved.
  // The config modal intentionally shows "None" in that case — the user
  // hasn't chosen yet, so we don't pre-select a store on their behalf.
  function preferredLink(links: { label: string; url: string }[]) {
    const pref = getStorePref() ?? "itch";
    const domain = STORE_DOMAINS[pref];
    if (domain) {
      const match = links.find((l) => l.url.includes(domain));
      if (match) return match;
    }
    return links[0];
  }
  function updateAdventureListLinks() {
    document
      .querySelectorAll("#adventure-list .adv-name a[data-links]")
      .forEach((a) => {
        const el = a as HTMLAnchorElement;
        const links = JSON.parse(el.dataset.links!);
        el.href = preferredLink(links).url;
      });
  }

  // --- Config overlay ---
  const configOverlay = document.getElementById(
    "config-overlay",
  ) as HTMLElement;
  function toggleConfig() {
    if (configOverlay.style.display === "none") {
      trackEvent("Preferences opened");
      // Sync radio buttons with current preference
      const pref = getStorePref() ?? "";
      const radio = configOverlay.querySelector(
        `input[name="store-pref"][value="${pref}"]`,
      );
      if (radio) (radio as HTMLInputElement).checked = true;
      configOverlay.style.display = "flex";
    } else {
      configOverlay.style.display = "none";
    }
  }
  document
    .getElementById("config-close")!
    .addEventListener("click", toggleConfig);
  configOverlay.addEventListener("click", (e) => {
    if (e.target === configOverlay) toggleConfig();
  });
  document.getElementById("config-save")!.addEventListener("click", () => {
    const selected = configOverlay.querySelector(
      'input[name="store-pref"]:checked',
    ) as HTMLInputElement | null;
    if (selected) {
      localStorage.setItem(STORE_PREF_KEY, selected.value);
      trackEvent("Store preference saved", {
        choice: selected.value || "none",
      });
      schedulePush();
    }
    updateAdventureListLinks();
    if (currentHex && sidebar.classList.contains("open")) {
      openSidebar(currentHex);
    }
    toggleConfig();
  });

  // Apply stored preference to adventure list links on load
  updateAdventureListLinks();

  const contactOverlay = document.getElementById(
    "contact-overlay",
  ) as HTMLElement;
  function toggleContact() {
    if (contactOverlay.style.display === "none") trackEvent("Contact opened");
    contactOverlay.style.display =
      contactOverlay.style.display === "none" ? "flex" : "none";
  }
  // document
  //   .getElementById("contact-link")!
  //   .addEventListener("click", toggleContact);
  document
    .getElementById("contact-close")!
    .addEventListener("click", toggleContact);
  contactOverlay.addEventListener("click", (e) => {
    if (e.target === contactOverlay) toggleContact();
  });
  //document
  //  .querySelector("#contact-box .btn-primary")!
  //  .addEventListener("click", () => {
  //    trackEvent("Contact button clicked");
  //  });

  // --- Auth overlay ---
  const authOverlay = document.getElementById("auth-overlay") as HTMLElement;
  const authBtn = document.getElementById("auth-btn") as HTMLElement;
  const authSignedOut = document.getElementById(
    "auth-signed-out",
  ) as HTMLElement;
  const authSignedIn = document.getElementById("auth-signed-in") as HTMLElement;
  const authUserName = document.getElementById("auth-user-name") as HTMLElement;
  const syncStatusEl = document.getElementById("sync-status") as HTMLElement;

  function updateAuthUI(user: any) {
    if (user) {
      authBtn.classList.add("signed-in");
      authBtn.setAttribute("aria-label", "Cloud sync settings");
      authBtn.setAttribute("data-tooltip", "Signed in — cloud sync active");
      authSignedOut.style.display = "none";
      authSignedIn.style.display = "";
      const name = user.user_metadata?.full_name || user.email || "Signed in";
      const provider = user.app_metadata?.provider;
      const providerIcons: Record<string, string> = {
        discord:
          '<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" style="vertical-align:-2px"><path d="M13.545 2.907a13.2 13.2 0 0 0-3.257-1.011.05.05 0 0 0-.052.025c-.141.25-.297.577-.406.833a12.2 12.2 0 0 0-3.658 0 8 8 0 0 0-.412-.833.05.05 0 0 0-.052-.025c-1.125.194-2.22.534-3.257 1.011a.04.04 0 0 0-.021.018C.356 6.024-.213 9.047.066 12.032q.003.022.021.037a13.3 13.3 0 0 0 3.995 2.02.05.05 0 0 0 .056-.019q.463-.63.818-1.329a.05.05 0 0 0-.01-.059l-.018-.011a9 9 0 0 1-1.248-.595.05.05 0 0 1-.02-.066l.015-.019q.127-.095.248-.195a.05.05 0 0 1 .051-.007c2.619 1.196 5.454 1.196 8.041 0a.05.05 0 0 1 .053.007q.121.1.248.195a.05.05 0 0 1-.004.085 8 8 0 0 1-1.249.594.05.05 0 0 0-.03.03.05.05 0 0 0 .003.041c.24.465.515.909.817 1.329a.05.05 0 0 0 .056.019 13.2 13.2 0 0 0 4.001-2.02.05.05 0 0 0 .021-.037c.334-3.451-.559-6.449-2.366-9.106a.03.03 0 0 0-.02-.019m-8.198 7.307c-.789 0-1.438-.724-1.438-1.612s.637-1.613 1.438-1.613c.807 0 1.45.73 1.438 1.613 0 .888-.637 1.612-1.438 1.612m5.316 0c-.788 0-1.438-.724-1.438-1.612s.637-1.613 1.438-1.613c.807 0 1.451.73 1.438 1.613 0 .888-.631 1.612-1.438 1.612"/></svg>',
        google:
          '<svg width="16" height="16" viewBox="0 0 24 24" style="vertical-align:-2px"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>',
      };
      const icon = providerIcons[provider] || "";
      authUserName.innerHTML = icon + (icon ? " " : "") + name;
    } else {
      authBtn.classList.remove("signed-in");
      authBtn.setAttribute("aria-label", "Sign in for cloud sync");
      authBtn.setAttribute(
        "data-tooltip",
        "Sign in to sync data across devices",
      );
      authSignedOut.style.display = "";
      authSignedIn.style.display = "none";
    }
  }

  function toggleAuth() {
    if (authOverlay.style.display === "none") {
      trackEvent("Auth opened");
      authOverlay.style.display = "flex";
    } else {
      authOverlay.style.display = "none";
    }
  }
  // authBtn.addEventListener("click", toggleAuth);
  document.getElementById("auth-close")!.addEventListener("click", toggleAuth);
  authOverlay.addEventListener("click", (e) => {
    if (e.target === authOverlay) toggleAuth();
  });

  document.getElementById("auth-discord-btn")!.addEventListener("click", () => {
    if (!sb) return;
    trackEvent("Auth sign in", { provider: "discord" });
    sb.auth.signInWithOAuth({
      provider: "discord",
      options: {
        redirectTo: window.location.origin + consentPath,
      },
    });
  });
  document.getElementById("auth-google-btn")!.addEventListener("click", () => {
    if (!sb) return;
    trackEvent("Auth sign in", { provider: "google" });
    sb.auth.signInWithOAuth({
      provider: "google",
      options: { redirectTo: window.location.origin + consentPath },
    });
  });
  document
    .getElementById("auth-signout-btn")!
    .addEventListener("click", async () => {
      if (!sb) return;
      trackEvent("Auth sign out");
      await sb.auth.signOut();
      updateAuthUI(null);
      toggleAuth();
    });

  // --- Updates overlay ---
  const UPDATES_SEEN_KEY = "map-updates-last-seen-id";
  const updatesOverlay = document.getElementById(
    "updates-overlay",
  ) as HTMLElement;
  const updatesDot = document.getElementById("updates-dot") as HTMLElement;

  // function checkUpdatesBadge() {
  //   if (!UPDATES.length) return;
  //   const lastSeenId =
  //     parseInt(localStorage.getItem(UPDATES_SEEN_KEY) ?? "", 10) || 0;
  //   if (UPDATES[0].id > lastSeenId) {
  //     updatesDot.classList.add("visible");
  //   }
  // }
  // checkUpdatesBadge();

  function toggleUpdates() {
    if (updatesOverlay.style.display === "none") {
      trackEvent("Updates opened");
      const content = document.getElementById("updates-content") as HTMLElement;
      // Group updates by date
      const grouped: Array<{ date: string; entries: any[] }> = [];
      for (const u of UPDATES) {
        const last = grouped[grouped.length - 1];
        if (last && last.date === u.date) {
          last.entries.push(u);
        } else {
          grouped.push({ date: u.date, entries: [u] });
        }
      }
      content.innerHTML = grouped
        .slice(0, 10)
        .map(
          (g) =>
            `<div class="update-group">
            <div class="update-date">${g.date}</div>
            ${g.entries
              .map(
                (u) =>
                  `<div class="update-entry">
                <div class="update-meta">
                  <span class="update-type">${u.type}</span>
                </div>
                <div class="update-title">${u.title}</div>
                <div class="update-desc">${u.description}</div>
              </div>`,
              )
              .join("")}
          </div>`,
        )
        .join("");
      localStorage.setItem(UPDATES_SEEN_KEY, String(UPDATES[0].id));
      schedulePush();
      updatesDot.classList.remove("visible");
      updatesOverlay.style.display = "flex";
    } else {
      updatesOverlay.style.display = "none";
    }
  }
  // document
  //   .getElementById("updates-bell")!
  //   .addEventListener("click", toggleUpdates);
  document
    .getElementById("updates-close")!
    .addEventListener("click", toggleUpdates);
  updatesOverlay.addEventListener("click", (e) => {
    if (e.target === updatesOverlay) toggleUpdates();
  });

  // --- Hex navigation state ---
  let currentHex: string | null = null;
  // let allHexIds: string[] = []; // populated after SVG load
  const hexPolys: Record<string, SVGPolygonElement> = {}; // hexId -> polygon element
  let activeHexShadow: SVGPolygonElement | null = null; // cloned polygon for drop shadow
  let setLabelSize: ((size: number) => void) | null = null; // assigned after SVG load
  // let getLabelSize: (() => number) | null = null;

  // --- Visited hex persistence ---
  // States: "visited" (fully explored) or "partial" (partially explored)
  const VISITED_KEY = "map-visited-hexes";
  const VISITED_V2_KEY = "map-visited-hexes-v2";
  function loadVisited() {
    try {
      const v2 = localStorage.getItem(VISITED_V2_KEY);
      if (v2) return new Map(JSON.parse(v2));
      // Migrate v1 Set format: treat all as "visited"
      const v1 = JSON.parse(localStorage.getItem(VISITED_KEY) || "[]");
      const migrated = new Map(v1.map((id: string) => [id, "visited"]));
      if (v1.length) {
        localStorage.setItem(VISITED_V2_KEY, JSON.stringify([...migrated]));
        localStorage.removeItem(VISITED_KEY);
      }
      return migrated;
    } catch {
      return new Map();
    }
  }
  // function saveVisited() {
  //   localStorage.setItem(VISITED_V2_KEY, JSON.stringify([...visitedHexes]));
  //   schedulePush();
  // }
  let visitedHexes = loadVisited();

  // --- Shared DM notes ---
  async function deleteNote(hexId: string) {
    if (sb) {
      const { error } = await sb.from("hex_notes").delete().eq("hex_id", hexId);
      if (error) {
        console.warn("Shared note delete failed:", error.message);
        return;
      }
    }
    delete hexNotes[hexId];
    updateNoteTextLabel(hexId);
    updateNoteFill(hexId);
  }
  let hexNotes: Record<string, SharedNote> = {};
  let notesEditMode = false;
  let svgDocRef: Document | null = null;
  let overlayRef: Element | null = null;
  let noteLabelGroup: SVGGElement | null = null;
  const noteLabels: Record<string, SVGTextElement> = {};
  let noteFillGroup: SVGGElement | null = null;
  const noteFills: Record<string, SVGPolygonElement> = {};

  function updateNoteTextLabel(hexId: string) {
    const existing = noteLabels[hexId];
    if (existing) {
      existing.remove();
      delete noteLabels[hexId];
    }

    const poly = hexPolys[hexId];
    const note = hexNotes[hexId];
    if (!svgDocRef || !noteLabelGroup || !poly || !note) return;
    const titleText = note.title;

    const points = poly.getAttribute("points");
    if (!points) return;

    const vertices = points
      .trim()
      .split(/\s+/)
      .map((point) => {
        const [x, y] = point.split(",").map(Number);
        return { x, y };
      });
    const centerX =
      vertices.reduce((sum, point) => sum + point.x, 0) / vertices.length;
    const centerY =
      vertices.reduce((sum, point) => sum + point.y, 0) / vertices.length;
    const polygonWidth =
      Math.max(...vertices.map((point) => point.x)) -
      Math.min(...vertices.map((point) => point.x));
    const maxTextWidth = polygonWidth * 0.82;

    const text = svgDocRef.createElementNS(
      "http://www.w3.org/2000/svg",
      "text",
    );
    text.setAttribute("x", String(centerX));
    text.setAttribute("y", String(centerY));
    text.setAttribute("text-anchor", "middle");
    text.setAttribute("dominant-baseline", "central");
    text.setAttribute("font-size", "28");
    text.setAttribute("font-family", "system-ui, sans-serif");
    text.setAttribute("fill", "#000000");
    noteLabelGroup.appendChild(text);

    const words = titleText.trim().split(/\s+/).filter(Boolean);
    const lines: string[] = [];
    let currentLine = "";
    for (const word of words) {
      const candidate = currentLine ? `${currentLine} ${word}` : word;
      text.textContent = candidate;
      if (currentLine && text.getComputedTextLength() > maxTextWidth) {
        lines.push(currentLine);
        currentLine = word;
      } else {
        currentLine = candidate;
      }
    }
    if (currentLine) lines.push(currentLine);

    text.textContent = "";
    const lineHeight = 32;
    const firstLineY = centerY - ((lines.length - 1) * lineHeight) / 2;
    lines.forEach((line, index) => {
      const tspan = svgDocRef!.createElementNS(
        "http://www.w3.org/2000/svg",
        "tspan",
      );
      tspan.setAttribute("x", String(centerX));
      tspan.setAttribute("y", String(firstLineY + index * lineHeight));
      tspan.textContent = line;
      text.appendChild(tspan);
    });

    noteLabels[hexId] = text;
  }

  function updateNoteFill(hexId: string) {
    const existing = noteFills[hexId];
    if (existing) {
      existing.remove();
      delete noteFills[hexId];
    }
    const poly = hexPolys[hexId];
    const note = hexNotes[hexId];
    if (!noteFillGroup || !poly || !note) return;

    const fill = poly.cloneNode(false) as SVGPolygonElement;
    fill.removeAttribute("data-hex");
    fill.removeAttribute("class");
    fill.style.fill = NOTE_CATEGORY_COLORS[note.category];
    fill.style.fillOpacity = "0.35";
    fill.style.stroke = "none";
    fill.style.pointerEvents = "none";
    noteFillGroup.appendChild(fill);
    noteFills[hexId] = fill;
  }

  function applySharedNote(
    hexId: string,
    content: string | null,
    category: NoteCategory = "news",
    title: string | null = "",
  ) {
    const safeCategory = NOTE_CATEGORY_COLORS[category] ? category : "news";
    if (content)
      hexNotes[hexId] = {
        title: title ?? "",
        content,
        category: safeCategory,
      };
    else delete hexNotes[hexId];
    updateNoteTextLabel(hexId);
    updateNoteFill(hexId);
    updateNoteBadge(hexId);
    if (currentHex === hexId && sidebar.classList.contains("open")) {
      renderNotesSection(hexId);
    }
  }

  async function initSharedNotes() {
    if (!sb) return;
    const { data, error } = await sb
      .from("hex_notes")
      .select("hex_id, title, content, category");
    if (error) {
      console.warn("Shared notes load failed:", error.message);
      return;
    }
    hexNotes = {};
    for (const note of data ?? []) {
      applySharedNote(note.hex_id, note.content, note.category, note.title);
    }

    sb.channel("shared-hex-notes")
      .on(
        "postgres_changes",
        { event: "*", schema: "public", table: "hex_notes" },
        (payload: any) => {
          const note =
            payload.eventType === "DELETE" ? payload.old : payload.new;
          if (note?.hex_id) {
            applySharedNote(
              note.hex_id,
              payload.eventType === "DELETE" ? null : note.content,
              note.category,
              note.title,
            );
          }
        },
      )
      .subscribe();
  }

  // --- Cloud sync (last-write-wins) ---
  // On load: cloud replaces local state. On change: local overwrites cloud.
  // No conflict resolution — designed for single user across devices.
  function gatherSyncData() {
    return {
      visitedHexes: [...visitedHexes],
      storePref: localStorage.getItem(STORE_PREF_KEY) || "",
      lastSeenUpdateId:
        parseInt(localStorage.getItem("map-updates-last-seen-id") ?? "", 10) ||
        0,
      labelSize:
        parseInt(localStorage.getItem("map-label-size") ?? "", 10) ||
        DEFAULT_LABEL_SIZE,
    };
  }

  function schedulePush() {
    if (!sb || isSyncing) return;
    if (pushTimer) clearTimeout(pushTimer);
    pushTimer = setTimeout(pushToCloud, 2000);
  }

  function mergeCloudData(cloud: any) {
    // Cloud is source of truth for visited hexes
    if (Array.isArray(cloud.visitedHexes)) {
      visitedHexes = new Map(cloud.visitedHexes);
      localStorage.setItem(VISITED_V2_KEY, JSON.stringify([...visitedHexes]));
      reapplyAllVisitedOverlays();
    }
    // Scalar prefs: cloud wins
    if (cloud.storePref !== undefined) {
      localStorage.setItem(STORE_PREF_KEY, cloud.storePref);
      updateAdventureListLinks();
    }
    if (cloud.lastSeenUpdateId) {
      const localSeen =
        parseInt(localStorage.getItem("map-updates-last-seen-id") ?? "", 10) ||
        0;
      if (cloud.lastSeenUpdateId > localSeen) {
        localStorage.setItem(
          "map-updates-last-seen-id",
          String(cloud.lastSeenUpdateId),
        );
        // checkUpdatesBadge();
      }
    }
    if (cloud.labelSize && setLabelSize) {
      localStorage.setItem("map-label-size", String(cloud.labelSize));
      setLabelSize(cloud.labelSize);
    }
  }

  async function pushToCloud() {
    if (!sb || isSyncing) return;
    try {
      const {
        data: { user },
      } = await sb.auth.getUser();
      if (!user) return;
      syncStatusEl.textContent = "Syncing...";
      const { error } = await sb.from("map_user_data").upsert({
        user_id: user.id,
        data: gatherSyncData(),
      });
      if (error) {
        console.warn("Cloud push failed:", error.message);
        syncStatusEl.textContent = "Sync failed";
      } else {
        syncStatusEl.textContent = "Synced";
      }
    } catch (err) {
      console.warn("Cloud push error:", err);
      syncStatusEl.textContent = "Sync failed";
    }
  }

  function reapplyAllVisitedOverlays() {
    // Clear existing overlays
    Object.keys(visitedOverlays).forEach((hexId) => {
      if (visitedOverlays[hexId]) {
        visitedOverlays[hexId].remove();
        delete visitedOverlays[hexId];
      }
    });
    // Reapply from current state
    visitedHexes.forEach((state, hexId) => applyVisitedOverlay(hexId, state));
    updateProgress();
  }

  async function syncFromCloud(user: any) {
    if (!sb || !user) return;
    isSyncing = true;
    syncStatusEl.textContent = "Syncing...";
    try {
      const { data, error } = await sb
        .from("map_user_data")
        .select("data")
        .eq("user_id", user.id)
        .maybeSingle();
      if (error) {
        console.warn("Cloud pull failed:", error.message);
        syncStatusEl.textContent = "Sync failed";
        isSyncing = false;
        return;
      }
      if (data && data.data) {
        mergeCloudData(data.data);
        syncStatusEl.textContent = "Synced";
      } else {
        // No cloud data yet - push local data up
        await pushToCloud();
      }
    } catch (err) {
      console.warn("Cloud sync error:", err);
      syncStatusEl.textContent = "Sync failed";
    }
    isSyncing = false;
  }

