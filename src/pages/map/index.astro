    <div id="contact-box" class="modal-box">
      <h3>About / Add / Correct / Contact</h3>
      <p>
        Know of a module that's missing from the map? Spot an error in a hex
        placement or description? Have a suggestion, complaint, or just want to
        say hi?
      </p>
      {
        contactMailto && (
          <p class="contact-cta">
            <a
              class="btn-primary"
              href={`mailto:${contactMailto}`}
              target="_blank"
            >
              Send an email
            </a>
          </p>
