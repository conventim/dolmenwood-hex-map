  function updateNoteBadge(hexId: string) {
    if (!svgDocRef || !overlayRef) return;
    // Remove existing badge
    const existing = overlayRef.querySelector(`[data-note-badge="${hexId}"]`);
    if (existing) existing.remove();
    if (!hexNotes[hexId]) return;

    const poly = hexPolys[hexId];
    if (!poly) return;
    const pts = poly
      .getAttribute("points")!
      .trim()
      .split(/\s+/)
      .map((p: string) => {
        const [x, y] = p.split(",").map(Number);
        return { x, y };
      });
    // Top-right vertex of hex polygon, nudged down
    const topRight = pts.reduce(
      (best: { x: number; y: number }, p: { x: number; y: number }) =>
        p.x - p.y > best.x - best.y ? p : best,
      pts[0],
    );
    topRight.y += 20;

    const g = svgDocRef.createElementNS("http://www.w3.org/2000/svg", "g");
    g.setAttribute("data-note-badge", hexId);
    g.setAttribute("pointer-events", "none");

    // const circle = svgDocRef.createElementNS(
