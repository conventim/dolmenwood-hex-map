  function escapeHtml(value: string) {
    return value.replace(
      /[&<>"]/g,
      (char) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
        })[char]!,
    );
  }

  function normalizeSearchText(value: string) {
    return value.replace(/\s+/g, " ").trim();
  }

  function noteContentSnippet(content: string, query: string) {
    const normalized = normalizeSearchText(content);
    const matchIndex = normalized.toLowerCase().indexOf(query.toLowerCase());
    if (matchIndex < 0) return normalized.slice(0, 120);

    const ranges = Array.from(normalized.matchAll(/\S+/g), (match) => ({
      text: match[0],
      start: match.index ?? 0,
      end: (match.index ?? 0) + match[0].length,
    }));
    const matchWordIndex = ranges.findIndex(
      (range) => range.start <= matchIndex && range.end >= matchIndex,
    );
    if (matchWordIndex < 0) return normalized.slice(0, 120);

    const startIndex = Math.max(0, matchWordIndex - 4);
    const endIndex = Math.min(ranges.length, matchWordIndex + 5);
    const snippet = ranges.slice(startIndex, endIndex).map((word) => word.text);
    return `${startIndex > 0 ? "... " : ""}${snippet.join(" ")}${
      endIndex < ranges.length ? " ..." : ""
    }`;
  }

  function searchNoteEntries(query: string) {
    const q = query.trim();
    if (!q) return [];

    const qLower = q.toLowerCase();
    return Object.entries(hexNotes)
      .flatMap(([hexId, note]) => {
        const title = normalizeSearchText(note.title || "");
        const content = normalizeSearchText(note.content || "");
        const titleLower = title.toLowerCase();
        const contentLower = content.toLowerCase();
        const titleMatches = titleLower.includes(qLower);
        const contentMatches = contentLower.includes(qLower);
        if (!titleMatches && !contentMatches) return [];

        const score =
          titleLower === qLower
            ? 95
            : titleLower.startsWith(qLower)
              ? 85
              : titleMatches
                ? 65
                : 35;
        const matchSource = titleMatches ? "Title" : "Note";
        const matchText = titleMatches ? title : noteContentSnippet(content, q);

        return [
          {
            hexId,
            label: title || `Note ${hexId}`,
            type: "note",
            typeBadge: "Note",
            searchText: `${title} ${content} ${hexId}`.toLowerCase(),
            score,
            matchText,
            matchSource,
          },
        ];
      })
      .sort((a, b) => {
        if (b.score !== a.score) return b.score - a.score;
        return a.label.localeCompare(b.label);
      });
  }

  function searchMapEntries(query: string) {
    const isNumeric = /^\d+$/.test(query.trim());
    const results = [
      ...searchEntries(query, SEARCH_INDEX),
      ...(isNumeric ? [] : searchNoteEntries(query)),
    ].map((entry) => {
      if (!isNumeric || entry.type !== "hex" || !entry.hexId) return entry;
      const title = normalizeSearchText(hexNotes[entry.hexId]?.title || "");
      return title
        ? { ...entry, matchText: title, matchSource: "Title" }
        : entry;
    });
    results.sort((a, b) => {
      if (b.score !== a.score) return b.score - a.score;
      return a.label.localeCompare(b.label);
    });
    return results.slice(0, 10);
  }

  function renderSearchResults(results: any[]) {
    const searchResultsList = document.getElementById(
      "search-results",
    ) as HTMLElement;
    const hexSearch = document.getElementById("hex-search") as HTMLInputElement;
    searchResultsList.innerHTML = "";
    currentSearchResults = results;
    searchSelectedIdx = -1;
    if (results.length === 0) {
      closeSearchDropdown();
      return;
    }
    results.forEach((entry, i) => {
      const li = document.createElement("li");
      li.setAttribute("role", "option");
      li.setAttribute("aria-selected", "false");
      li.dataset.index = String(i);
      const hexDisplay =
        entry.type === "location-module" ? entry.location : entry.hexId;
      const matchDisplay = entry.matchText
        ? `<span class="sr-match">${escapeHtml(
            entry.matchSource
              ? `${entry.matchSource}: ${entry.matchText}`
              : entry.matchText,
          )}</span>`
        : "";
      li.innerHTML =
        `<span class="sr-badge">${escapeHtml(entry.typeBadge)}</span>` +
        `<span class="sr-main"><span class="sr-label">${escapeHtml(
          entry.label,
        )}</span>${matchDisplay}</span>` +
        (entry.type !== "hex"
          ? `<span class="sr-hex">${escapeHtml(hexDisplay || "")}</span>`
          : "");
      li.addEventListener("click", () => selectSearchResult(entry));
      searchResultsList.appendChild(li);
    });
    searchResultsList.setAttribute("data-open", "true");
    hexSearch.setAttribute("aria-expanded", "true");
  }

  function updateSearchSelection(newIdx: number) {
    const items = document
      .getElementById("search-results")!
      .querySelectorAll("li");
    if (items[searchSelectedIdx]) {
      items[searchSelectedIdx].setAttribute("aria-selected", "false");
    }
    searchSelectedIdx = newIdx;
    if (items[searchSelectedIdx]) {
      items[searchSelectedIdx].setAttribute("aria-selected", "true");
      items[searchSelectedIdx].scrollIntoView({ block: "nearest" });
    }
  }

  function selectSearchResult(entry: any) {
    const hexSearch = document.getElementById("hex-search") as HTMLInputElement;
    trackEvent("Search", {
      query: hexSearch.value,
      type: entry.type,
      hex: entry.hexId,
    });
    hexSearch.value = "";
    closeSearchDropdown();
    clearHexHighlights();
    hexSearch.blur();
    if (entry.type === "location-module") {
      const details = document.querySelector(
        `#adventure-list details[data-module="${entry.label}"]`,
      ) as HTMLDetailsElement | null;
      if (details) {
        details.open = true;
        details.scrollIntoView({ behavior: "smooth" });
      }
      return;
    }
    if (hexPolys[entry.hexId]) selectHex(entry.hexId);
    openSidebar(entry.hexId);
  }

