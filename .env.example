# All values are optional. Unset values disable the corresponding feature.

# Absolute origin used to build absolute og:image URLs (no trailing slash).
# Unset: og:image tags are omitted.
PUBLIC_SITE_URL=

# Canonical URL for the map page, if the map is mirrored on multiple hosts.
# Unset: no canonical tag.
PUBLIC_CANONICAL_URL=

# Domain registered with onedollarstats. Unset: analytics disabled entirely.
PUBLIC_ANALYTICS_DOMAIN=

# Supabase project for optional cross-device progress sync (table: map_user_data).
# Unset: auth UI is hidden and progress stays in localStorage.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Contact email shown in the contact modal and privacy page.
# Plus-tags (+dolmenwood-map, +privacy) are added automatically.
# Unset: contact links are not rendered.
PUBLIC_CONTACT_EMAIL=
